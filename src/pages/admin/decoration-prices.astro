---
import '../../styles/global.css';
---
<html lang="pt-BR"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Preços de personalização | Painel administrativo</title></head><body><main class="min-h-screen px-5 py-10 sm:px-8 sm:py-16"><section class="mx-auto max-w-6xl"><div class="flex flex-wrap items-center justify-between gap-4"><div><a href="/admin" class="brand-display text-2xl font-bold text-[#18324a]">Art Brasil <span class="font-normal italic text-[#c96f4a]">Presentes</span></a><p class="mt-8 text-sm font-bold uppercase tracking-[0.2em] text-[#c96f4a]">Painel administrativo</p><h1 class="brand-display mt-3 text-4xl font-bold text-[#18324a]">Tabela de personalização</h1><p class="mt-2 text-[#486174]">Edite preços, faixas de quantidade e quantidade de cores.</p></div><a href="/admin" class="rounded-full border border-[#18324a] px-5 py-2.5 font-bold text-[#18324a]">Voltar ao painel</a></div><div id="error" class="mt-8 hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-900"></div><section id="editor" class="mt-8 hidden"><div class="flex flex-wrap gap-3"><button id="add-row" class="rounded-full bg-[#c96f4a] px-5 py-3 font-bold text-white">Adicionar faixa</button><button id="add-column" class="rounded-full border border-[#18324a] px-5 py-3 font-bold text-[#18324a]">Adicionar coluna de cores</button><button id="save" class="rounded-full bg-[#18324a] px-5 py-3 font-bold text-white">Salvar tabela</button></div><div class="mt-5 overflow-x-auto rounded-3xl border border-[#d8cfc2] bg-[#fffdf9]"><table class="w-full min-w-[42rem] border-collapse"><thead id="head" class="bg-[#18324a] text-left text-white"></thead><tbody id="body"></tbody></table></div><p class="mt-4 text-sm leading-6 text-[#486174]">As quantidades intermediárias usam a faixa imediatamente inferior. Valores vazios não entram no cálculo.</p></section></section></main><div id="loading" class="operation-loading hidden" role="alert"><div class="operation-loading-card"><span class="loading-spinner"></span><span>Processando...</span></div></div><script>
import { supabase } from '../../lib/supabase';
type Cell = { quantidade: number; cores: number; valor: number }; let cells: Cell[] = []; const editor = document.querySelector<HTMLElement>('#editor'); const head = document.querySelector<HTMLElement>('#head'); const body = document.querySelector<HTMLElement>('#body'); const error = document.querySelector<HTMLElement>('#error'); const loading = document.querySelector<HTMLElement>('#loading'); const showError = (text: string) => { if (error) { error.textContent = text; error.classList.remove('hidden'); } }; const setLoading = (active: boolean) => loading?.classList.toggle('hidden', !active);
const render = () => { if (!head || !body) return; const quantities = [...new Set(cells.map((cell) => cell.quantidade))].sort((a, b) => a - b); const colors = [...new Set(cells.map((cell) => cell.cores))].sort((a, b) => a - b); head.innerHTML = `<tr><th class="px-4 py-3">Quantidade <span class="text-xs font-normal">(excluir)</span></th>${colors.map((color) => `<th class="px-4 py-3"><div class="flex items-center gap-2">${color} ${color === 1 ? 'cor' : 'cores'}<button data-delete-column="${color}" title="Excluir coluna" class="rounded-full bg-white/15 px-2 py-1 text-xs hover:bg-red-400">🗑</button></div></th>`).join('')}</tr>`; body.innerHTML = quantities.map((quantity) => `<tr class="border-t border-[#e4ddd2] odd:bg-[#fff8f1]"><th class="px-4 py-3 text-left text-[#18324a]"><div class="flex items-center gap-2"><input data-quantity="${quantity}" type="number" min="1" value="${quantity}" class="w-28 rounded-xl border border-[#d8cfc2] bg-white px-3 py-2 font-bold" /><button data-delete-row="${quantity}" title="Excluir faixa" class="rounded-full border border-red-300 px-2 py-1 text-xs text-red-700 hover:bg-red-50">🗑</button></div></th>${colors.map((color) => { const cell = cells.find((item) => item.quantidade === quantity && item.cores === color); return `<td class="px-4 py-3"><input data-price-quantity="${quantity}" data-price-color="${color}" type="number" min="0" step="0.01" value="${cell?.valor ?? ''}" class="w-28 rounded-xl border border-[#d8cfc2] bg-white px-3 py-2" /></td>`; }).join('')}</tr>`).join(''); };
const load = async () => { setLoading(true); const { data, error: queryError } = await supabase.from('precos_decoracao').select('quantidade, cores, valor').order('quantidade').order('cores'); setLoading(false); if (queryError) return showError(queryError.message); cells = (data ?? []).map((cell) => ({ ...cell, valor: Number(cell.valor) })); editor?.classList.remove('hidden'); render(); };
document.querySelector('#add-row')?.addEventListener('click', () => { const quantities = cells.map((cell) => cell.quantidade); const next = Math.max(0, ...quantities) + 10; const colors = [...new Set(cells.map((cell) => cell.cores))]; cells.push(...colors.map((cores) => ({ quantidade: next, cores, valor: 0 }))); render(); });
document.querySelector('#add-column')?.addEventListener('click', () => { const next = Math.max(0, ...cells.map((cell) => cell.cores)) + 1; const quantities = [...new Set(cells.map((cell) => cell.quantidade))]; cells.push(...quantities.map((quantidade) => ({ quantidade, cores: next, valor: 0 }))); render(); });
body?.addEventListener('click', (event) => { const target = event.target as HTMLElement; const row = target.closest<HTMLButtonElement>('[data-delete-row]'); const column = target.closest<HTMLButtonElement>('[data-delete-column]'); if (row) { const quantity = Number(row.dataset.deleteRow); cells = cells.filter((cell) => cell.quantidade !== quantity); render(); } if (column) { const color = Number(column.dataset.deleteColumn); cells = cells.filter((cell) => cell.cores !== color); render(); } });
head?.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete-column]'); if (!button) return; const color = Number(button.dataset.deleteColumn); cells = cells.filter((cell) => cell.cores !== color); render(); });
document.querySelector('#save')?.addEventListener('click', async () => { setLoading(true); const rows = [...(body?.querySelectorAll<HTMLInputElement>('[data-quantity]') ?? [])]; const nextCells: Cell[] = []; rows.forEach((row) => { const quantity = Number(row.value); body?.querySelectorAll<HTMLInputElement>(`[data-price-quantity="${row.dataset.quantity}"]`).forEach((input) => { nextCells.push({ quantidade: quantity, cores: Number(input.dataset.priceColor), valor: Number(input.value || 0) }); }); }); const { error: deleteError } = await supabase.from('precos_decoracao').delete().gt('quantidade', 0); if (!deleteError) { const { error: insertError } = await supabase.from('precos_decoracao').insert(nextCells); if (insertError) showError(insertError.message); else cells = nextCells; } else showError(deleteError.message); setLoading(false); render(); });
const start = async () => { const { data } = await supabase.auth.getSession(); if (!data.session) return showError('Faça login no painel para editar os preços.'); const { data: profile } = await supabase.from('perfis_admin').select('ativo').eq('user_id', data.session.user.id).eq('ativo', true).maybeSingle(); if (!profile) return showError('Seu usuário não tem permissão para editar os preços.'); await load(); }; start();
</script></body></html>
