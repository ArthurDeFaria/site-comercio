---
import '../../styles/global.css';
---

<html lang="pt-BR">
		<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><link rel="icon" type="image/png" href="/logo.png?v=4" /><meta name="robots" content="noindex, nofollow" /><title>Portfólio | Painel administrativo</title></head>
	<body>
		<main class="min-h-screen px-5 py-10 sm:px-8 sm:py-16"><section class="mx-auto max-w-5xl">
			<div class="flex flex-wrap items-center justify-between gap-4"><div><a href="/admin" class="brand-display text-2xl font-bold text-[#18324a]">Art Brasil <span class="font-normal italic text-[#c96f4a]">Presentes</span></a><p class="mt-8 text-sm font-bold uppercase tracking-[0.2em] text-[#c96f4a]">Painel administrativo</p><h1 class="brand-display mt-3 text-4xl font-bold text-[#18324a]">Portfólio</h1><p class="mt-2 text-[#486174]">Gerencie as imagens exibidas na galeria pública.</p></div><div class="flex gap-2"><button id="new-project-button" type="button" class="rounded-full bg-[#c96f4a] px-5 py-2.5 font-bold text-white">Novo trabalho</button><a href="/admin" class="rounded-full border border-[#18324a] px-5 py-2.5 font-bold text-[#18324a]">Voltar ao painel</a></div></div>
			<div id="auth-error" class="mt-8 hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-900"></div>
			<div id="portfolio-editor" class="admin-modal hidden" role="dialog" aria-modal="true" aria-labelledby="form-title"><div class="admin-modal-backdrop" data-close-editor></div><form id="portfolio-form" class="admin-modal-card max-w-3xl rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-6 shadow-xl sm:p-8">
				<input id="project-id" type="hidden" /><input id="old-image-path" type="hidden" />
				<h2 id="form-title" class="brand-display text-3xl font-bold text-[#18324a]">Novo trabalho</h2>
				<div class="mt-6 grid gap-5 sm:grid-cols-2"><div><label for="project-title" class="block text-sm font-bold text-[#18324a]">Título</label><input id="project-title" required class="mt-2 w-full rounded-2xl border border-[#d8cfc2] px-4 py-3" /></div><div><label for="project-order" class="block text-sm font-bold text-[#18324a]">Ordem</label><input id="project-order" type="number" min="0" value="0" required class="mt-2 w-full rounded-2xl border border-[#d8cfc2] px-4 py-3" /></div></div>
				<div class="mt-5"><label for="project-description" class="block text-sm font-bold text-[#18324a]">Descrição curta</label><textarea id="project-description" rows="3" class="mt-2 w-full rounded-2xl border border-[#d8cfc2] px-4 py-3"></textarea></div>
				<div class="mt-5"><label for="project-image" class="block text-sm font-bold text-[#18324a]">Imagem</label><input id="project-image" type="file" accept="image/*" class="mt-2 block w-full rounded-2xl border border-dashed border-[#d8cfc2] bg-[#f7f3ec] p-4" /><p id="image-hint" class="mt-2 text-xs text-[#486174]">Obrigatória para um novo trabalho; opcional ao editar.</p></div>
				<label class="mt-5 flex items-center gap-3 text-sm font-bold text-[#18324a]"><input id="project-active" type="checkbox" checked class="h-5 w-5 accent-[#c96f4a]" /> Exibir na galeria pública</label>
				<p id="form-message" class="mt-5 hidden rounded-2xl p-4 text-sm" role="alert"></p><div class="mt-6 flex gap-3"><button class="rounded-full bg-[#18324a] px-5 py-3 font-bold text-white" type="submit">Salvar trabalho</button><button id="cancel-edit" class="rounded-full border border-[#18324a] px-5 py-3 font-bold text-[#18324a]" type="button">Limpar</button></div>
			</form></div>
			<div id="project-list" class="mt-8 grid gap-4 sm:grid-cols-2"><p class="text-[#486174]">Carregando...</p></div>
		</section></main>
		<div id="operation-loading" class="operation-loading hidden" role="alert" aria-live="assertive" aria-busy="true"><div class="operation-loading-card"><span class="loading-spinner" aria-hidden="true"></span><span id="operation-loading-message">Processando...</span></div></div>
		<div id="delete-confirm-modal" class="admin-modal hidden" role="dialog" aria-modal="true" aria-labelledby="delete-confirm-title"><div class="admin-modal-backdrop" data-close-delete></div><section class="admin-modal-card max-w-lg rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-6 shadow-2xl sm:p-8"><p class="text-sm font-bold uppercase tracking-[0.16em] text-[#c96f4a]">Confirmar ação</p><h2 id="delete-confirm-title" class="brand-display mt-2 text-3xl font-bold text-[#18324a]">Excluir trabalho?</h2><p class="mt-3 leading-6 text-[#486174]">Esse trabalho será removido da galeria e a imagem será apagada do Storage.</p><div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"><button type="button" data-close-delete class="rounded-full border border-[#18324a] px-5 py-3 font-bold text-[#18324a]">Cancelar</button><button id="confirm-delete" type="button" class="rounded-full bg-[#a95235] px-5 py-3 font-bold text-white">Excluir trabalho</button></div></section></div>
		<script>
			import { supabase } from '../../lib/supabase';
			const operationLoading = document.querySelector<HTMLElement>('#operation-loading'); const operationLoadingMessage = document.querySelector<HTMLElement>('#operation-loading-message'); let pendingRequests = 0; let loadingTimer: number | undefined;
			const originalFetch = window.fetch.bind(window);
			window.fetch = async (...args) => { pendingRequests += 1; if (operationLoadingMessage) operationLoadingMessage.textContent = 'Processando...'; if (loadingTimer === undefined) loadingTimer = window.setTimeout(() => { operationLoading?.classList.remove('hidden'); document.body.classList.add('modal-is-open'); loadingTimer = undefined; }, 180); try { return await originalFetch(...args); } finally { pendingRequests -= 1; if (pendingRequests === 0) { if (loadingTimer !== undefined) window.clearTimeout(loadingTimer); loadingTimer = undefined; operationLoading?.classList.add('hidden'); document.body.classList.remove('modal-is-open'); } } };
			const form = document.querySelector<HTMLFormElement>('#portfolio-form'); const editor = document.querySelector<HTMLElement>('#portfolio-editor'); const deleteModal = document.querySelector<HTMLElement>('#delete-confirm-modal'); const confirmDelete = document.querySelector<HTMLButtonElement>('#confirm-delete'); const list = document.querySelector<HTMLElement>('#project-list'); const authError = document.querySelector<HTMLElement>('#auth-error'); const message = document.querySelector<HTMLElement>('#form-message'); let pendingDelete: any = null;
			const fields = { id: document.querySelector<HTMLInputElement>('#project-id')!, old: document.querySelector<HTMLInputElement>('#old-image-path')!, title: document.querySelector<HTMLInputElement>('#project-title')!, description: document.querySelector<HTMLTextAreaElement>('#project-description')!, order: document.querySelector<HTMLInputElement>('#project-order')!, image: document.querySelector<HTMLInputElement>('#project-image')!, active: document.querySelector<HTMLInputElement>('#project-active')! };
			const storageBase = `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/produtos/`; let projects: any[] = [];
			const createUploadId = () => {
				if (typeof crypto.randomUUID === 'function') return crypto.randomUUID();
				if (typeof crypto.getRandomValues === 'function') return Array.from(crypto.getRandomValues(new Uint8Array(16)), (byte) => byte.toString(16).padStart(2, '0')).join('');
				return `${Date.now()}-${Math.random().toString(36).slice(2)}`;
			};
			const showMessage = (text: string, error = false) => { if (!message) return; message.textContent = text; message.className = `mt-5 rounded-2xl p-4 text-sm ${error ? 'border border-red-200 bg-red-50 text-red-900' : 'border border-green-200 bg-green-50 text-green-900'}`; };
			const closeEditor = () => { editor?.classList.add('hidden'); document.body.classList.remove('modal-is-open'); };
			const reset = () => { form?.reset(); fields.id.value = ''; fields.old.value = ''; fields.order.value = '0'; fields.active.checked = true; const title = document.querySelector('#form-title'); if (title) title.textContent = 'Novo trabalho'; };
			const openEditor = () => { reset(); editor?.classList.remove('hidden'); document.body.classList.add('modal-is-open'); fields.title.focus(); };
			const render = () => { if (!list) return; list.innerHTML = projects.length ? projects.map((p) => `<article draggable="true" data-project-card="${p.id}" class="group cursor-grab overflow-hidden rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] shadow-sm active:cursor-grabbing"><div class="relative"><img src="${p.imagem_path.startsWith('http') ? p.imagem_path : storageBase + p.imagem_path}" alt="" class="aspect-video w-full object-cover"><span class="absolute right-3 top-3 rounded-full bg-[#18324a]/85 px-3 py-1 text-xs font-bold text-white">↕ Arraste</span></div><div class="p-5"><div class="flex justify-between gap-3"><h2 class="text-lg font-bold text-[#18324a]">${p.titulo}</h2><span class="text-xs font-bold ${p.ativo ? 'text-green-700' : 'text-[#486174]'}">${p.ativo ? 'Ativo' : 'Oculto'}</span></div><p class="mt-2 text-sm text-[#486174]">${p.descricao || 'Sem descrição'}</p><div class="mt-4 flex gap-2"><button data-edit="${p.id}" class="rounded-full border border-[#18324a] px-4 py-2 text-sm font-bold text-[#18324a]">Editar</button><button data-delete="${p.id}" class="rounded-full border border-red-300 px-4 py-2 text-sm font-bold text-red-700">Excluir</button></div></div></article>`).join('') : '<p class="rounded-3xl border border-dashed border-[#d8cfc2] p-8 text-center text-[#486174] sm:col-span-2">Nenhum trabalho cadastrado.</p>'; };
			const saveOrder = async () => { const updates = projects.map((project, index) => supabase.from('portfolio_projetos').update({ ordem: index }).eq('id', project.id)); const results = await Promise.all(updates); const error = results.find((result) => result.error)?.error; if (error) showMessage(error.message, true); else showMessage('Ordem do portfólio atualizada.'); };
			const load = async () => { const { data, error } = await supabase.from('portfolio_projetos').select('*').order('ordem').order('created_at', { ascending: false }); if (error) { showMessage(error.message, true); return; } projects = data ?? []; render(); };
			const start = async () => { const { data } = await supabase.auth.getSession(); if (!data.session) { if (authError) { authError.textContent = 'Faça login no painel para gerenciar o portfólio.'; authError.classList.remove('hidden'); } return; } const { data: profile } = await supabase.from('perfis_admin').select('ativo').eq('user_id', data.session.user.id).eq('ativo', true).maybeSingle(); if (!profile) { if (authError) { authError.textContent = 'Seu usuário não tem permissão para gerenciar o portfólio.'; authError.classList.remove('hidden'); } return; } await load(); };
			form?.addEventListener('submit', async (event) => { event.preventDefault(); const file = fields.image.files?.[0]; let imagePath = fields.old.value; try { if (!fields.id.value && !file) throw new Error('Escolha uma imagem para o trabalho.'); if (file) { const safeName = file.name.toLowerCase().replace(/[^a-z0-9.-]+/g, '-'); imagePath = `portfolio/${createUploadId()}-${safeName}`; const upload = await supabase.storage.from('produtos').upload(imagePath, file, { contentType: file.type, upsert: false }); if (upload.error) throw upload.error; } const payload = { titulo: fields.title.value.trim(), descricao: fields.description.value.trim(), imagem_path: imagePath, ordem: Number(fields.order.value), ativo: fields.active.checked }; const result = fields.id.value ? await supabase.from('portfolio_projetos').update(payload).eq('id', fields.id.value) : await supabase.from('portfolio_projetos').insert(payload); if (result.error) throw result.error; closeEditor(); reset(); await load(); } catch (error) { showMessage(error instanceof Error ? error.message : 'Não foi possível salvar o trabalho.', true); } });
			const closeDelete = () => { deleteModal?.classList.add('hidden'); pendingDelete = null; document.body.classList.remove('modal-is-open'); }; const executeDelete = async () => { if (!pendingDelete) return; const p = pendingDelete; closeDelete(); const result = await supabase.from('portfolio_projetos').delete().eq('id', p.id); if (result.error) showMessage(result.error.message, true); else { if (p.imagem_path && !p.imagem_path.startsWith('http')) await supabase.storage.from('produtos').remove([p.imagem_path]); await load(); } };
			let draggingId = ''; let draggingCard: HTMLElement | null = null; let dragPreview: HTMLElement | null = null; let placeholder: HTMLElement | null = null; let lastDropKey = ''; let orderChanged = false; list?.addEventListener('dragstart', (event) => { const card = (event.target as HTMLElement).closest<HTMLElement>('[data-project-card]'); const dragEvent = event as DragEvent; if (!card) return; draggingId = card.dataset.projectCard ?? ''; draggingCard = card; dragPreview = card.cloneNode(true) as HTMLElement; dragPreview.style.position = 'fixed'; dragPreview.style.top = '-10000px'; dragPreview.style.left = '-10000px'; dragPreview.style.width = `${card.getBoundingClientRect().width}px`; dragPreview.style.opacity = '0.9'; document.body.appendChild(dragPreview); dragEvent.dataTransfer?.setDragImage(dragPreview, 40, 40); placeholder = document.createElement('div'); placeholder.className = 'h-24 rounded-3xl border-2 border-dashed border-[#c96f4a] bg-[#fff1e9]'; card.parentElement?.insertBefore(placeholder, card.nextSibling); card.classList.add('hidden'); lastDropKey = ''; orderChanged = false; }); list?.addEventListener('dragend', async (event) => { const card = (event.target as HTMLElement).closest<HTMLElement>('[data-project-card]'); if (card) card.classList.remove('hidden'); if (card && placeholder) placeholder.parentElement?.insertBefore(card, placeholder); placeholder?.remove(); dragPreview?.remove(); placeholder = null; dragPreview = null; if (orderChanged) { projects = Array.from(list?.querySelectorAll<HTMLElement>('[data-project-card]') ?? []).map((item) => projects.find((project) => project.id === item.dataset.projectCard)!).filter(Boolean).map((project, index) => ({ ...project, ordem: index })); await saveOrder(); } draggingId = ''; draggingCard = null; lastDropKey = ''; orderChanged = false; }); list?.addEventListener('dragover', (event) => { event.preventDefault(); if (!draggingCard || !placeholder || !list) return; const targetCard = (event.target as HTMLElement).closest<HTMLElement>('[data-project-card]'); if (!targetCard || targetCard === draggingCard) return; const rect = targetCard.getBoundingClientRect(); const insertAfter = event.clientY > rect.top + rect.height / 2 || (Math.abs(event.clientY - (rect.top + rect.height / 2)) < rect.height / 3 && event.clientX > rect.left + rect.width / 2); const dropKey = `${targetCard.dataset.projectCard}:${insertAfter ? 'after' : 'before'}`; if (dropKey === lastDropKey) return; lastDropKey = dropKey; targetCard.parentElement?.insertBefore(placeholder, insertAfter ? targetCard.nextSibling : targetCard); orderChanged = true; }); list?.addEventListener('drop', (event) => { event.preventDefault(); });
			list?.addEventListener('click', async (event) => { const target = event.target as HTMLElement; const edit = target.closest<HTMLButtonElement>('[data-edit]'); const del = target.closest<HTMLButtonElement>('[data-delete]'); if (edit) { const p = projects.find((item) => item.id === edit.dataset.edit); if (!p) return; fields.id.value = p.id; fields.old.value = p.imagem_path; fields.title.value = p.titulo; fields.description.value = p.descricao; fields.order.value = p.ordem; fields.active.checked = p.ativo; const title = document.querySelector('#form-title'); if (title) title.textContent = 'Editar trabalho'; editor?.classList.remove('hidden'); document.body.classList.add('modal-is-open'); fields.title.focus(); } if (del) { pendingDelete = projects.find((item) => item.id === del.dataset.delete); if (pendingDelete) { deleteModal?.classList.remove('hidden'); document.body.classList.add('modal-is-open'); } } });
			document.querySelector('#new-project-button')?.addEventListener('click', openEditor); document.querySelector('#cancel-edit')?.addEventListener('click', () => { reset(); closeEditor(); }); editor?.querySelectorAll<HTMLElement>('[data-close-editor]').forEach((element) => element.addEventListener('click', closeEditor)); deleteModal?.querySelectorAll<HTMLElement>('[data-close-delete]').forEach((element) => element.addEventListener('click', closeDelete)); confirmDelete?.addEventListener('click', executeDelete); document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { closeEditor(); closeDelete(); } }); start();
		</script>
	</body>
</html>
