---
import { supabase } from '../lib/supabase';
import type { Produto } from '../types/catalog';
import '../styles/global.css';

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
const { data, error } = await supabase
	.from('produtos')
	.select('id, nome, codigo, preco_peca_branca, quantidade_minima, fotos, tags, destaque')
	.order('destaque', { ascending: false })
	.order('nome');

const produtos = (data ?? []) as Produto[];
const tags = [...new Set(produtos.flatMap((produto) => produto.tags))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const storageUrl = import.meta.env.PUBLIC_SUPABASE_URL + '/storage/v1/object/public/produtos/';
const logoUrl = `${storageUrl}logo/logo.jpeg`;
const formatPrice = (value: number | string) =>
	Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const productImage = (path: string) =>
	path.startsWith('http') ? path : `${storageUrl}${path.replace(/^\/+/, '')}`;
const whatsappLink = (produto: Produto) =>
	`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
		`Olá! Vim pelo site da Art Brasil e gostaria de orçar: ${produto.nome}.`,
	)}`;
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Porcelanas personalizadas da Art Brasil Presentes. Consulte produtos e peça seu orçamento pelo WhatsApp."
		/>
		<title>Art Brasil Presentes | Porcelanas personalizadas</title>
	</head>
	<body>
		<header class="border-b border-[#e4ddd2] bg-[#fffdf9]">
			<div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-4 sm:gap-4 sm:px-8 sm:py-5">
				<a href="/" class="brand-display min-w-0 text-2xl font-bold text-[#18324a] sm:text-3xl">
					Art Brasil <span class="font-normal italic text-[#c96f4a]">Presentes</span>
				</a>
			</div>
		</header>

		<main>
			<section class="hero-wash border-b border-[#e4ddd2]">
				<div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
					<div class="max-w-2xl">
						<p class="text-sm font-bold uppercase tracking-[0.2em] text-[#c96f4a]">Peças que contam histórias</p>
						<h1 class="brand-display mt-4 text-5xl font-bold leading-[0.98] text-[#18324a] sm:text-7xl">
							Porcelana feita para <span class="italic text-[#c96f4a]">ficar na memória.</span>
						</h1>
						<p class="mt-6 max-w-xl text-lg leading-8 text-[#486174]">
							Peças personalizadas para presentear, celebrar e levar a sua marca para momentos especiais.
						</p>
						<a
							href="#catalogo"
							class="mt-8 inline-flex rounded-full bg-[#18324a] px-6 py-3.5 font-bold text-white hover:bg-[#274c69]"
						>
							Conhecer o catálogo <span class="ml-2" aria-hidden="true">↓</span>
						</a>
					</div>
					<div class="relative hidden min-h-64 lg:block">
						<div class="absolute inset-8 rotate-3 rounded-[3rem] bg-[#dce8e8]"></div>
						<div class="relative flex min-h-64 items-center justify-center rounded-[3rem] border border-[#e4ddd2] bg-[#fffdf9] p-10 shadow-xl">
							<img
								src={logoUrl}
								alt="Logo Art Brasil Presentes Finos"
								class="max-h-56 w-full max-w-sm object-contain lg:max-h-[26rem] lg:max-w-[36rem]"
							/>
						</div>
					</div>
				</div>
			</section>

			<section id="catalogo" class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
				<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.2em] text-[#c96f4a]">Escolha com calma</p>
						<h2 id="catalog-title" class="brand-display mt-2 text-4xl font-bold text-[#18324a]">Nosso catálogo</h2>
					</div>
					{produtos.length > 0 && <p class="text-sm text-[#486174]">{produtos.length} produto(s)</p>}
				</div>
				<p class="mt-5 rounded-2xl border border-[#e8c9a5] bg-[#fff4e8] px-5 py-3 text-center text-sm text-[#7b4a2d]">
					<strong>Importante:</strong> o valor dos produtos não inclui o frete, e o prazo de entrega deve ser consultado.
				</p>

				{error ? (
					<div class="mt-8 rounded-3xl border border-red-200 bg-red-50 p-6 text-red-900" role="alert">
						<h3 class="font-semibold">Não foi possível carregar o catálogo.</h3>
						<p class="mt-2 text-sm">Tente novamente em alguns instantes ou fale conosco pelo WhatsApp.</p>
					</div>
				) : produtos.length === 0 ? (
					<div class="mt-8 rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-8 text-center">
						<h3 class="text-lg font-semibold">Estamos preparando nosso catálogo</h3>
						<p class="mx-auto mt-2 max-w-xl text-slate-600">
							Enquanto isso, fale com nossa equipe para consultar produtos e condições especiais.
						</p>
						<a
							href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
								'Olá! Vim pelo site da Art Brasil e gostaria de conhecer os produtos.',
							)}`}
							class="mt-5 inline-flex rounded-full bg-[#c96f4a] px-5 py-3 font-bold text-white hover:bg-[#a95235]"
						>
							Pedir informações pelo WhatsApp
						</a>
					</div>
				) : (
					<>
						<div class="catalog-search mt-8">
							<label for="product-search" class="block text-sm font-bold text-[#18324a]">
								Encontre seu produto
							</label>
							<div class="relative mt-2">
								<span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-[#c96f4a]" aria-hidden="true">
									<svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2">
										<circle cx="11" cy="11" r="7"></circle>
										<path d="m20 20-4-4"></path>
									</svg>
								</span>
								<input
									id="product-search"
									type="search"
									class="w-full rounded-2xl border border-[#d8cfc2] bg-[#fffdf9] py-3.5 pl-12 pr-12 text-[#18324a] shadow-sm placeholder:text-[#7b8b95] focus:border-[#c96f4a] focus:outline-none focus:ring-2 focus:ring-[#c96f4a]/20"
									placeholder="Busque por nome, tag, capacidade ou código"
									autocomplete="off"
								/>
								<button
									id="clear-product-search"
									type="button"
									class="absolute right-4 top-1/2 hidden h-10 -translate-y-1/2 items-center rounded-lg px-2 text-sm font-bold text-[#486174] hover:bg-[#f1e8dc] hover:text-[#18324a]"
									aria-label="Limpar busca"
								>
									Limpar
								</button>
							</div>
							<p class="mt-2 text-xs text-[#486174]">Você pode digitar apenas parte do nome, como “300”, “can” ou “café”.</p>
						</div>

						{tags.length > 0 && (
							<nav class="mt-8 flex flex-wrap gap-2" aria-label="Filtrar produtos por categoria">
								<button
									type="button"
									class="filter-button is-active rounded-full border border-[#18324a] bg-[#18324a] px-4 py-3 text-sm font-bold text-white"
									data-filter="todos"
								>
									Todos
								</button>
								{tags.map((tag) => (
									<button
										type="button"
										class="filter-button rounded-full border border-[#c8d0d2] bg-[#fffdf9] px-4 py-3 text-sm font-bold text-[#486174] hover:border-[#18324a]"
										data-filter={tag}
									>
										{tag}
									</button>
								))}
							</nav>
						)}

						<p class="mt-4 text-sm text-slate-600" aria-live="polite">
							<span id="visible-product-count">{produtos.length}</span> produto(s) exibido(s)
						</p>

					<div id="product-grid" class="mt-2 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{produtos.map((produto) => (
							<article
								class:list={[
									'product-card flex h-full flex-col overflow-hidden rounded-3xl border shadow-sm',
									{ 'is-featured': produto.destaque },
								]}
								data-tags={produto.tags.join('|')}
								data-search={`${produto.nome} ${produto.codigo} ${produto.tags.join(' ')} ${produto.fotos.join(' ')}`}
							>
								{produto.fotos.length > 0 ? (
									<div class="product-gallery" data-gallery data-image-loading>
										<div class="relative">
											<div class="gallery-loading" aria-hidden="true">
												<span class="loading-spinner"></span>
												<span>Carregando imagem...</span>
											</div>
											{produto.destaque && (
												<span class="featured-badge absolute left-4 top-4 z-10 rounded-full px-3 py-1.5 text-xs font-bold uppercase tracking-[0.12em]">
													Destaque
												</span>
											)}
											{produto.fotos.map((foto, index) => (
												<img
													src={productImage(foto)}
													alt={`${produto.nome} - imagem ${index + 1} de ${produto.fotos.length}`}
													class:list={[
														'aspect-square w-full object-cover',
														{ hidden: index !== 0 },
													]}
													data-gallery-image
													data-image-index={index}
													loading={index === 0 ? 'eager' : 'lazy'}
												/>
											))}
											{produto.fotos.length > 1 && (
												<>
													<button
														type="button"
														class="gallery-control gallery-previous absolute left-3 top-1/2 -translate-y-1/2 rounded-full border-2 border-[#18324a] bg-[#fffdf9]/95 text-xl font-bold text-[#18324a] shadow-lg hover:bg-white"
														aria-label={`Ver imagem anterior de ${produto.nome}`}
													>
														<span class="flex h-full items-center justify-center text-4xl leading-none -translate-y-px" aria-hidden="true">‹</span>
													</button>
													<button
														type="button"
														class="gallery-control gallery-next absolute right-3 top-1/2 -translate-y-1/2 rounded-full border-2 border-[#18324a] bg-[#fffdf9]/95 text-xl font-bold text-[#18324a] shadow-lg hover:bg-white"
														aria-label={`Ver próxima imagem de ${produto.nome}`}
													>
														<span class="flex h-full items-center justify-center text-4xl leading-none -translate-y-px" aria-hidden="true">›</span>
													</button>
													<p
														class="gallery-counter absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-[#18324a]/85 px-3 py-1 text-xs font-bold text-white"
														aria-live="polite"
													>
														1 / {produto.fotos.length}
													</p>
												</>
											)}
										</div>
									</div>
								) : (
									<div class="relative flex aspect-square items-center justify-center bg-[#e8eef0] text-sm text-[#486174]">
										{produto.destaque && (
											<span class="featured-badge absolute left-4 top-4 rounded-full px-3 py-1.5 text-xs font-bold uppercase tracking-[0.12em]">
												Destaque
											</span>
										)}
										Foto em breve
									</div>
								)}
								<div class="flex flex-1 flex-col p-5">
									<h3 class="flex min-h-14 items-center justify-center text-center text-lg font-bold text-[#18324a]">{produto.nome}</h3>
									<p class="mt-3 flex min-h-10 items-baseline justify-end gap-2 text-right text-2xl font-bold text-[#c96f4a] sm:text-3xl">
										{formatPrice(produto.preco_peca_branca)}
										<span class="text-sm font-normal text-[#486174]">por pç</span>
									</p>
								<div class="mt-auto grid gap-2">
									<a
										href={whatsappLink(produto)}
										class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#c96f4a] px-4 py-3 text-center font-bold text-white hover:bg-[#a95235]"
									>
										Pedir orçamento pelo WhatsApp
									</a>
									<button
										type="button"
										class="simulation-open-button inline-flex min-h-11 w-full items-center justify-center rounded-full border-2 border-[#18324a] px-4 py-2.5 text-center font-bold text-[#18324a] hover:bg-[#e8eef0]"
										data-product-name={produto.nome}
										data-product-price={produto.preco_peca_branca}
										data-product-minimum={produto.quantidade_minima}
										aria-haspopup="dialog"
									>
										Calcular personalização
									</button>
								</div>
								</div>
							</article>
						))}
					</div>
					<div id="no-search-results" class="mt-8 hidden rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-8 text-center" role="status">
						<h3 class="text-lg font-semibold text-[#18324a]">Nenhum produto encontrado</h3>
						<p class="mt-2 text-sm text-[#486174]">Tente outro nome, capacidade, código ou tag.</p>
					</div>
					</>
				)}
			</section>
		</main>
		<div id="simulation-modal" class="simulation-modal hidden" role="dialog" aria-modal="true" aria-labelledby="simulation-title" data-whatsapp-number={whatsappNumber}>
			<div class="simulation-modal-backdrop" data-close-simulation></div>
			<section class="simulation-modal-card rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-5 shadow-2xl sm:p-8">
				<div class="flex items-start justify-between gap-4">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.16em] text-[#c96f4a]">Simulador de personalização</p>
						<h2 id="simulation-title" class="brand-display mt-2 text-3xl font-bold text-[#18324a]">Calcular personalização</h2>
						<p id="simulation-product" class="mt-2 text-base font-bold text-[#486174]"></p>
					</div>
					<button type="button" class="rounded-full p-2 text-2xl leading-none text-[#486174] hover:bg-[#f1e8dc] hover:text-[#18324a]" data-close-simulation aria-label="Fechar simulador">×</button>
				</div>

				<form id="simulation-form" class="mt-7 space-y-6">
					<div>
						<div class="flex items-center justify-between gap-3">
							<label for="simulation-quantity" class="block text-base font-bold text-[#18324a]">Quantidade de peças</label>
							<output id="simulation-quantity-output" for="simulation-quantity" class="rounded-full bg-[#fff1e9] px-3 py-1.5 text-base font-bold text-[#a95235]">10 peças</output>
						</div>
						<div class="mt-4 flex items-center gap-3">
							<button id="simulation-quantity-decrease" type="button" class="simulation-quantity-button" aria-label="Diminuir quantidade">−</button>
							<input id="simulation-quantity" type="range" min="10" max="201" step="1" value="10" class="simulation-range w-full" aria-describedby="simulation-quantity-help" />
							<button id="simulation-quantity-increase" type="button" class="simulation-quantity-button" aria-label="Aumentar quantidade">+</button>
						</div>
						<div class="mt-1 flex justify-between text-sm font-bold text-[#486174]" aria-hidden="true">
							<span>10</span>
							<span>200+</span>
						</div>
						<p id="simulation-quantity-help" class="mt-2 text-sm text-[#486174]">Arraste ou use os botões para escolher de uma em uma peça.</p>
					</div>

					<div>
						<label for="simulation-colors" class="block text-base font-bold text-[#18324a]">Cores da personalização</label>
						<select id="simulation-colors" class="mt-2 w-full rounded-2xl border border-[#d8cfc2] bg-white px-4 py-3.5 text-[#18324a] focus:border-[#c96f4a] focus:outline-none focus:ring-2 focus:ring-[#c96f4a]/20">
							<option value="1">1 cor</option>
							<option value="2">2 cores</option>
							<option value="3">3 cores</option>
							<option value="4">4 cores</option>
							<option value="5">5 cores</option>
							<option value="6">6 cores</option>
						</select>
					</div>

					<fieldset>
						<legend class="block text-base font-bold text-[#18324a]">Tipo de aplicação</legend>
						<div class="mt-2 grid gap-3 sm:grid-cols-2">
							<label class="simulation-choice">
								<input type="radio" name="simulation-application" value="frente" checked />
								<span><strong>Frente</strong><small class="text-sm">Logotipo</small></span>
							</label>
							<label class="simulation-choice">
								<input type="radio" name="simulation-application" value="faixa" />
								<span><strong>Faixa</strong><small class="text-sm">Em volta da peça</small></span>
							</label>
						</div>
					</fieldset>

					<div class="space-y-2">
						<p class="rounded-2xl border border-[#e8c9a5] bg-[#fff4e8] px-4 py-3 text-base leading-6 text-[#7b4a2d]">
							<strong>Prazo de entrega:</strong> consulte a equipe antes de fechar o pedido.
						</p>
						<p class="rounded-2xl border border-[#c8d0d2] bg-[#e8eef0] px-4 py-3 text-base leading-6 text-[#486174]">
							Para uma estimativa mais precisa, faça um orçamento pelo WhatsApp. Os valores não incluem frete.
						</p>
						<p id="simulation-minimum-order" class="rounded-2xl border border-[#b8cbe0] bg-[#eef5fb] px-4 py-3 text-base font-bold leading-6 text-[#18324a]" role="status">
							Pedido mínimo: consulte a quantidade mínima deste produto.
						</p>
					</div>
					<div id="simulation-result" class="rounded-2xl border border-[#d99a70] bg-[#fff1e9] p-5" aria-live="polite">
						<p class="text-base font-bold uppercase tracking-[0.14em] text-[#a95235]">Estimativa da decoração</p>
						<div class="mt-4 space-y-2 rounded-xl bg-white/70 px-4 py-3 text-base leading-7 text-[#486174]">
							<p class="font-bold text-[#18324a]">Como chegamos ao valor:</p>
							<p id="simulation-piece-calculation">Peças: 10 × R$ 0,00 = R$ 0,00</p>
							<p id="simulation-decoration-calculation">Personalização: 10 × R$ 12,50 = R$ 125,00</p>
						</div>
						<p id="simulation-total-price" class="mt-4 border-t-2 border-[#d99a70] pt-3 text-xl font-bold text-[#a95235] sm:text-2xl">Total estimado: R$ 125,00 + frete</p>
						<a id="simulation-special-quote" class="mx-auto mt-4 hidden inline-flex min-h-11 items-center justify-center rounded-full bg-[#c96f4a] px-4 py-2.5 text-center font-bold text-white hover:bg-[#a95235]" target="_blank" rel="noreferrer">Cotar condição especial no WhatsApp</a>
					</div>
					<div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
						<button type="button" data-close-simulation class="inline-flex min-h-12 items-center justify-center rounded-full border-2 border-[#18324a] px-5 py-3 font-bold text-[#18324a] hover:bg-[#e8eef0]">Fechar</button>
					</div>
				</form>
			</section>
		</div>
		<a
			href={`https://wa.me/${whatsappNumber}`}
			class="fixed bottom-5 right-5 z-20 flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-xl hover:bg-[#1daa50] sm:bottom-7 sm:right-7"
			aria-label="Falar com a Art Brasil pelo WhatsApp"
			title="Falar pelo WhatsApp"
		>
			<svg viewBox="0 0 24 24" class="h-8 w-8 fill-current" aria-hidden="true">
				<path d="M20.5 3.5A11.8 11.8 0 0 0 12.06 0C5.52 0 .2 5.32.2 11.86c0 2.09.55 4.13 1.59 5.93L.1 24l6.36-1.67a11.85 11.85 0 0 0 5.6 1.42h.01c6.54 0 11.86-5.32 11.86-11.86 0-3.17-1.23-6.15-3.43-8.39Zm-8.44 18.2h-.01a9.84 9.84 0 0 1-5.01-1.37l-.36-.21-3.77.99 1.01-3.68-.23-.38a9.82 9.82 0 0 1-1.5-5.19C2.19 6.43 6.62 2 12.06 2c2.64 0 5.12 1.03 6.98 2.9a9.8 9.8 0 0 1 2.88 6.99c0 5.44-4.43 9.81-9.86 9.81Zm5.4-7.35c-.3-.15-1.78-.88-2.05-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.95 1.18-.17.2-.35.23-.65.08-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.08-.15-.68-1.64-.93-2.25-.24-.59-.49-.51-.68-.52h-.58c-.2 0-.53.08-.8.38-.28.3-1.06 1.03-1.06 2.52s1.08 2.92 1.23 3.12c.15.2 2.12 3.24 5.13 4.54.72.31 1.28.49 1.72.63.72.23 1.37.2 1.89.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35Z" />
			</svg>
		</a>
		<script>
			const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
			const cards = document.querySelectorAll<HTMLElement>('.product-card');
			const count = document.querySelector<HTMLElement>('#visible-product-count');
			const searchInput = document.querySelector<HTMLInputElement>('#product-search');
			const clearSearch = document.querySelector<HTMLButtonElement>('#clear-product-search');
			const noSearchResults = document.querySelector<HTMLElement>('#no-search-results');
			const simulationModal = document.querySelector<HTMLElement>('#simulation-modal');
			const simulationProduct = document.querySelector<HTMLElement>('#simulation-product');
			const simulationForm = document.querySelector<HTMLFormElement>('#simulation-form');
			const simulationQuantity = document.querySelector<HTMLInputElement>('#simulation-quantity');
			const simulationQuantityOutput = document.querySelector<HTMLOutputElement>('#simulation-quantity-output');
			const simulationQuantityDecrease = document.querySelector<HTMLButtonElement>('#simulation-quantity-decrease');
			const simulationQuantityIncrease = document.querySelector<HTMLButtonElement>('#simulation-quantity-increase');
			const simulationColors = document.querySelector<HTMLSelectElement>('#simulation-colors');
			const simulationMinimumOrder = document.querySelector<HTMLElement>('#simulation-minimum-order');
			const simulationPieceCalculation = document.querySelector<HTMLElement>('#simulation-piece-calculation');
			const simulationDecorationCalculation = document.querySelector<HTMLElement>('#simulation-decoration-calculation');
			const simulationTotalPrice = document.querySelector<HTMLElement>('#simulation-total-price');
			const simulationSpecialQuote = document.querySelector<HTMLAnchorElement>('#simulation-special-quote');
			const simulationWhatsappNumber = simulationModal?.dataset.whatsappNumber ?? '';
			let lastSimulationTrigger: HTMLButtonElement | null = null;
			let selectedSimulationProduct = '';
			let selectedSimulationProductPrice = 0;
			let selectedSimulationProductMinimum = 10;
			let selectedFilter = 'todos';
			const decorationPrices: Record<number, Record<number, number>> = {
				10: { 1: 12.5, 2: 17.5, 3: 21.5, 4: 26, 5: 30, 6: 35 },
				20: { 1: 7.5, 2: 10, 3: 12, 4: 15, 5: 17, 6: 20 },
				30: { 1: 5.85, 2: 7.5, 3: 8.9, 4: 10.5, 5: 12, 6: 13 },
				40: { 1: 5, 2: 6.3, 3: 7.25, 4: 8.5, 5: 9.5, 6: 10.5 },
				50: { 1: 4.5, 2: 5.5, 3: 6.3, 4: 7.2, 5: 8, 6: 9 },
				100: { 1: 3.5, 2: 4, 3: 4.4, 4: 5, 5: 5.5, 6: 5.9 },
				200: { 1: 3.3, 2: 3.5, 3: 3.5, 4: 3.9, 5: 4.5, 6: 4.5 },
			};
			const formatSimulationPrice = (value: number) => value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
			const getQuantityBand = (quantity: number) => Object.keys(decorationPrices).map(Number).filter((band) => band <= quantity).pop() ?? null;
			const getApplicationMultiplier = () => document.querySelector<HTMLInputElement>('input[name="simulation-application"]:checked')?.value === 'faixa' ? 3 : 1;
			const updateSimulation = () => {
				const quantity = Number(simulationQuantity?.value ?? 10);
				const colors = Number(simulationColors?.value ?? 1);
				const band = quantity > 200 ? null : getQuantityBand(quantity);
				if (!simulationPieceCalculation || !simulationDecorationCalculation || !simulationTotalPrice || !simulationSpecialQuote) return;
				if (simulationMinimumOrder) simulationMinimumOrder.textContent = `Pedido mínimo: ${selectedSimulationProductMinimum} peças.`;
				if (simulationPieceCalculation) simulationPieceCalculation.textContent = `Peças: ${quantity} × ${formatSimulationPrice(selectedSimulationProductPrice)} = ${formatSimulationPrice(selectedSimulationProductPrice * quantity)}`;
				if (!band) {
					if (simulationDecorationCalculation) simulationDecorationCalculation.textContent = `Personalização: condição especial para ${quantity > 200 ? 'mais de 200' : quantity} peças.`;
					simulationTotalPrice.textContent = 'Total estimado: consulte a equipe + frete';
					simulationSpecialQuote.classList.remove('hidden');
					simulationSpecialQuote.href = `https://wa.me/${simulationWhatsappNumber}?text=${encodeURIComponent(`Olá! Vim pelo site da Art Brasil e gostaria de cotar uma condição especial para ${selectedSimulationProduct} em quantidade acima de 200 peças.`)}`;
					return;
				}
				const unitPrice = (decorationPrices[band]?.[colors] ?? 0) * getApplicationMultiplier();
				if (simulationDecorationCalculation) simulationDecorationCalculation.textContent = `Personalização: ${quantity} × ${formatSimulationPrice(unitPrice)} = ${formatSimulationPrice(unitPrice * quantity)}`;
				const subtotal = (selectedSimulationProductPrice + unitPrice) * quantity;
				simulationTotalPrice.textContent = `Total estimado: ${formatSimulationPrice(subtotal)} + frete`;
				simulationSpecialQuote.classList.add('hidden');
			};

			const updateQuantityOutput = () => {
				if (!simulationQuantityOutput || !simulationQuantity) return;
				const value = Number(simulationQuantity.value);
				simulationQuantityOutput.textContent = value > 200 ? '200+ peças' : `${value} peças`;
				if (simulationQuantityDecrease) simulationQuantityDecrease.disabled = value <= 10;
				if (simulationQuantityIncrease) simulationQuantityIncrease.disabled = value >= 201;
			};
			updateQuantityOutput();
			updateSimulation();
			simulationQuantity?.addEventListener('input', updateQuantityOutput);
			simulationQuantity?.addEventListener('input', updateSimulation);
			simulationColors?.addEventListener('change', updateSimulation);
			document.querySelectorAll<HTMLInputElement>('input[name="simulation-application"]').forEach((input) => input.addEventListener('change', updateSimulation));
			simulationQuantityDecrease?.addEventListener('click', () => {
				if (!simulationQuantity) return;
				simulationQuantity.value = String(Math.max(10, Number(simulationQuantity.value) - 1));
				updateQuantityOutput();
				updateSimulation();
			});
			simulationQuantityIncrease?.addEventListener('click', () => {
				if (!simulationQuantity) return;
				simulationQuantity.value = String(Math.min(201, Number(simulationQuantity.value) + 1));
				updateQuantityOutput();
				updateSimulation();
			});

			const closeSimulation = () => {
				simulationModal?.classList.add('hidden');
				document.body.classList.remove('modal-is-open');
				lastSimulationTrigger?.focus();
				lastSimulationTrigger = null;
			};
			document.querySelectorAll<HTMLButtonElement>('.simulation-open-button').forEach((button) => {
				button.addEventListener('click', () => {
					lastSimulationTrigger = button;
					simulationForm?.reset();
					selectedSimulationProduct = button.dataset.productName ?? '';
					selectedSimulationProductPrice = Number(button.dataset.productPrice ?? 0);
					selectedSimulationProductMinimum = Math.max(1, Number(button.dataset.productMinimum ?? 10));
					if (simulationQuantity) simulationQuantity.value = String(Math.min(201, Math.max(10, selectedSimulationProductMinimum)));
					updateQuantityOutput();
					updateSimulation();
					if (simulationProduct) simulationProduct.textContent = `Produto: ${button.dataset.productName ?? ''}`;
					simulationModal?.classList.remove('hidden');
					document.body.classList.add('modal-is-open');
					window.setTimeout(() => simulationForm?.querySelector<HTMLElement>('select')?.focus(), 0);
				});
			});
			simulationModal?.querySelectorAll<HTMLElement>('[data-close-simulation]').forEach((element) => element.addEventListener('click', closeSimulation));
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && !simulationModal?.classList.contains('hidden')) closeSimulation();
			});
			simulationForm?.addEventListener('submit', (event) => event.preventDefault());

			const normalizeText = (value: string) =>
				value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('pt-BR');

			const updateResults = () => {
				const searchTerms = normalizeText(searchInput?.value.trim() ?? '').split(/\s+/).filter(Boolean);
				let visibleCards = 0;

				cards.forEach((card) => {
					const productTags = (card.dataset.tags ?? '').split('|').map(normalizeText);
					const searchableText = normalizeText(card.dataset.search ?? '');
					const matchesFilter = selectedFilter === 'todos' || productTags.includes(normalizeText(selectedFilter));
					const matchesSearch = searchTerms.every((term) => searchableText.includes(term));
					const isVisible = matchesFilter && matchesSearch;
					card.hidden = !isVisible;
					if (isVisible) visibleCards += 1;
				});

				if (count) count.textContent = String(visibleCards);
				noSearchResults?.classList.toggle('hidden', visibleCards > 0);
				clearSearch?.classList.toggle('hidden', !searchInput?.value);
				clearSearch?.classList.toggle('inline-flex', Boolean(searchInput?.value));
			};

			document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
				const images = Array.from(gallery.querySelectorAll<HTMLImageElement>('[data-gallery-image]'));
				const previous = gallery.querySelector<HTMLButtonElement>('.gallery-previous');
				const next = gallery.querySelector<HTMLButtonElement>('.gallery-next');
				const counter = gallery.querySelector<HTMLElement>('.gallery-counter');
				let currentIndex = 0;

				const showImage = (index: number) => {
					currentIndex = (index + images.length) % images.length;
					images.forEach((image, imageIndex) => {
						image.classList.toggle('hidden', imageIndex !== currentIndex);
					});
					if (counter) counter.textContent = `${currentIndex + 1} / ${images.length}`;
				};

				previous?.addEventListener('click', () => showImage(currentIndex - 1));
				next?.addEventListener('click', () => showImage(currentIndex + 1));
				images.forEach((image) => {
					image.addEventListener('load', () => gallery.removeAttribute('data-image-loading'), { once: true });
					image.addEventListener('error', () => gallery.setAttribute('data-image-error', ''), { once: true });
					if (image.complete) {
						if (image.naturalWidth > 0) gallery.removeAttribute('data-image-loading');
						else gallery.setAttribute('data-image-error', '');
					}
				});

				if (images.length > 1) {
					window.setInterval(() => showImage(currentIndex + 1), 10000);
				}
			});

			buttons.forEach((button) => {
				button.addEventListener('click', () => {
					selectedFilter = button.dataset.filter ?? 'todos';

					buttons.forEach((currentButton) => {
						const isSelected = currentButton === button;
						currentButton.classList.toggle('is-active', isSelected);
						currentButton.classList.toggle('text-white', isSelected);
						currentButton.classList.toggle('border-[#c8d0d2]', !isSelected);
						currentButton.classList.toggle('bg-[#fffdf9]', !isSelected);
						currentButton.classList.toggle('text-[#486174]', !isSelected);
					});

					updateResults();
				});
			});

			searchInput?.addEventListener('input', updateResults);
			clearSearch?.addEventListener('click', () => {
				if (searchInput) {
					searchInput.value = '';
					searchInput.focus();
				}
				updateResults();
			});
		</script>
	</body>
</html>
