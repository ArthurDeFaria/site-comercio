---
import { supabase } from '../lib/supabase';
import type { Produto } from '../types/catalog';

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
const { data, error } = await supabase
	.from('produtos')
	.select('id, nome, codigo, preco_peca_branca, fotos, tags, destaque')
	.order('destaque', { ascending: false })
	.order('nome');

const produtos = (data ?? []) as Produto[];
const tags = [...new Set(produtos.flatMap((produto) => produto.tags))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const storageUrl = import.meta.env.PUBLIC_SUPABASE_URL + '/storage/v1/object/public/produtos/';
const formatPrice = (value: number | string) =>
	Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const productImage = (path: string) =>
	path.startsWith('http') ? path : `${storageUrl}${path.replace(/^\/+/, '')}`;
const whatsappLink = (produto: Produto) =>
	`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
		`Olá! Vim pelo site da Art Brasil e gostaria de orçar: ${produto.nome}.`,
	)}`;
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Porcelanas personalizadas da Art Brasil Presentes. Consulte produtos e peça seu orçamento pelo WhatsApp."
		/>
		<title>Art Brasil Presentes | Porcelanas personalizadas</title>
	</head>
	<body class="bg-stone-50 text-slate-900">
		<header class="border-b border-slate-200 bg-white">
			<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
				<a href="/" class="text-xl font-semibold tracking-tight text-slate-900">
					Art Brasil <span class="font-normal text-amber-700">Presentes</span>
				</a>
				<a
					href={`https://wa.me/${whatsappNumber}`}
					class="rounded-full bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700 focus:outline-2 focus:outline-offset-2 focus:outline-amber-600"
				>
					Falar no WhatsApp
				</a>
			</div>
		</header>

		<main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
			<section class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-700">Art Brasil Presentes</p>
				<h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">
					Porcelanas para marcar momentos especiais
				</h1>
				<p class="mt-4 text-lg leading-8 text-slate-600">
					Encontre a peça ideal e fale diretamente com nossa equipe para receber um orçamento.
				</p>
			</section>

			<section class="mt-12" aria-labelledby="catalog-title">
				<div class="flex items-end justify-between gap-4">
					<h2 id="catalog-title" class="text-2xl font-semibold text-slate-950">Catálogo</h2>
					{produtos.length > 0 && <p class="text-sm text-slate-600">{produtos.length} produto(s)</p>}
				</div>

				{error ? (
					<div class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-6 text-red-900" role="alert">
						<h3 class="font-semibold">Não foi possível carregar o catálogo.</h3>
						<p class="mt-2 text-sm">Tente novamente em alguns instantes ou fale conosco pelo WhatsApp.</p>
					</div>
				) : produtos.length === 0 ? (
					<div class="mt-6 rounded-2xl border border-slate-200 bg-white p-8 text-center">
						<h3 class="text-lg font-semibold">Estamos preparando nosso catálogo</h3>
						<p class="mx-auto mt-2 max-w-xl text-slate-600">
							Enquanto isso, fale com nossa equipe para consultar produtos e condições especiais.
						</p>
						<a
							href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
								'Olá! Vim pelo site da Art Brasil e gostaria de conhecer os produtos.',
							)}`}
							class="mt-5 inline-flex rounded-full bg-amber-600 px-5 py-3 font-semibold text-white hover:bg-amber-700 focus:outline-2 focus:outline-offset-2 focus:outline-amber-600"
						>
							Pedir informações pelo WhatsApp
						</a>
					</div>
				) : (
					<>
						{tags.length > 0 && (
							<nav class="mt-6 flex flex-wrap gap-2" aria-label="Filtrar produtos por categoria">
								<button
									type="button"
									class="filter-button rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white focus:outline-2 focus:outline-offset-2 focus:outline-slate-900"
									data-filter="todos"
								>
									Todos
								</button>
								{tags.map((tag) => (
									<button
										type="button"
										class="filter-button rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900"
										data-filter={tag}
									>
										{tag}
									</button>
								))}
							</nav>
						)}

						<p class="mt-4 text-sm text-slate-600" aria-live="polite">
							<span id="visible-product-count">{produtos.length}</span> produto(s) exibido(s)
						</p>

					<div id="product-grid" class="mt-2 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{produtos.map((produto) => (
							<article
								class="product-card overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
								data-tags={produto.tags.join('|')}
							>
								{produto.fotos[0] ? (
									<img
										src={productImage(produto.fotos[0])}
										alt={produto.nome}
										class="aspect-square w-full object-cover"
										loading="lazy"
									/>
								) : (
									<div class="flex aspect-square items-center justify-center bg-slate-100 text-sm text-slate-500">
										Foto em breve
									</div>
								)}
								<div class="p-5">
									{produto.destaque && (
										<p class="text-xs font-semibold uppercase tracking-wider text-amber-700">Destaque</p>
									)}
									<h3 class="mt-1 text-lg font-semibold">{produto.nome}</h3>
									<p class="mt-3 text-xl font-semibold text-slate-950">
										{formatPrice(produto.preco_peca_branca)}
										<span class="text-sm font-normal text-slate-500"> por peça branca</span>
									</p>
									<a
										href={whatsappLink(produto)}
										class="mt-5 inline-flex w-full justify-center rounded-full bg-amber-600 px-4 py-3 text-center font-semibold text-white hover:bg-amber-700 focus:outline-2 focus:outline-offset-2 focus:outline-amber-600"
									>
										Pedir orçamento pelo WhatsApp
									</a>
								</div>
							</article>
						))}
					</div>
					</>
				)}
			</section>
		</main>
		<script>
			const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
			const cards = document.querySelectorAll<HTMLElement>('.product-card');
			const count = document.querySelector<HTMLElement>('#visible-product-count');

			buttons.forEach((button) => {
				button.addEventListener('click', () => {
					const selectedFilter = button.dataset.filter ?? 'todos';
					let visibleCards = 0;

					buttons.forEach((currentButton) => {
						const isSelected = currentButton === button;
						currentButton.classList.toggle('bg-slate-900', isSelected);
						currentButton.classList.toggle('text-white', isSelected);
						currentButton.classList.toggle('border-slate-300', !isSelected);
						currentButton.classList.toggle('bg-white', !isSelected);
						currentButton.classList.toggle('text-slate-700', !isSelected);
					});

					cards.forEach((card) => {
						const productTags = card.dataset.tags?.split('|') ?? [];
						const isVisible = selectedFilter === 'todos' || productTags.includes(selectedFilter);
						card.hidden = !isVisible;
						if (isVisible) visibleCards += 1;
					});

					if (count) count.textContent = String(visibleCards);
				});
			});
		</script>
	</body>
</html>
