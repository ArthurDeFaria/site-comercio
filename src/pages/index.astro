---
import type { Produto } from '../types/catalog';
import '../styles/global.css';

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://artbrasilpresentes.com.br');
const produtos: Produto[] = [];
const tags: string[] = [];
const error = null;
const renderCatalog = false;
const storageUrl = import.meta.env.PUBLIC_SUPABASE_URL + '/storage/v1/object/public/produtos/';
const logoUrl = '/favicon.jpg';
const formatPrice = (value: number | string) =>
	Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const promotionalPrice = (produto: Produto) => {
	const promo = Number(produto.preco_promocional ?? 0);
	return promo > 0 ? promo : Number(produto.preco_peca_branca);
};
const productImage = (path: string) =>
	path.startsWith('http') ? path : `${storageUrl}${path.replace(/^\/+/, '')}`;
const whatsappLink = (produto: Produto) =>
	`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
		`Olá! Vim pelo site da Art Brasil e gostaria de orçar: ${produto.nome}.`,
	)}`;
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" type="image/jpeg" href="/favicon.jpg?v=2" />
		<meta name="viewport" content="width=device-width" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href="/sitemap.xml" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Porcelanas personalizadas para brindes corporativos, eventos e estabelecimentos em Pedreira (SP). Explore o catálogo da Art Brasil Presentes e peça seu orçamento pelo WhatsApp."
		/>
		<title>Porcelanas personalizadas em Pedreira | Art Brasil Presentes</title>
	</head>
	<body id="topo">
		<header class="border-b border-[#e4ddd2] bg-[#fffdf9]">
			<div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-4 sm:gap-4 sm:px-8 sm:py-5">
				<a href="/" class="brand-display min-w-0 text-2xl font-bold text-[#18324a] sm:text-3xl">
					Art Brasil <span class="font-normal italic text-[#c96f4a]">Presentes</span>
				</a>
			</div>
		</header>

		<main>
			<section class="hero-wash border-b border-[#e4ddd2]">
				<div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
					<div class="max-w-2xl">
						<p class="text-sm font-bold uppercase tracking-[0.2em] text-[#c96f4a]">Peças que contam histórias</p>
						<h1 class="brand-display mt-4 text-5xl font-bold leading-[0.98] text-[#18324a] sm:text-7xl">
							Porcelanas personalizadas para <span class="italic text-[#c96f4a]">momentos especiais.</span>
						</h1>
						<p class="mt-6 max-w-xl text-lg leading-8 text-[#486174]">
							Brindes corporativos e peças de porcelana personalizadas para eventos e estabelecimentos.
						</p>
						<a
							href="#catalogo"
							class="mt-8 inline-flex rounded-full bg-[#18324a] px-6 py-3.5 font-bold text-white hover:bg-[#274c69]"
						>
							Conhecer o catálogo <span class="ml-2" aria-hidden="true">↓</span>
						</a>
					</div>
					<div class="relative hidden min-h-64 lg:block">
						<div class="absolute inset-8 rotate-3 rounded-[3rem] bg-[#dce8e8]"></div>
						<div class="relative flex min-h-64 items-center justify-center rounded-[3rem] border border-[#e4ddd2] bg-[#fffdf9] p-10 shadow-xl">
							<img
								src={logoUrl}
								alt="Logo Art Brasil Presentes Finos"
								class="max-h-56 w-full max-w-sm object-contain lg:max-h-[26rem] lg:max-w-[36rem]"
								decoding="async"
							/>
						</div>
					</div>
				</div>
			</section>

			<section class="border-b border-[#e4ddd2] bg-[#f3eee6]" aria-labelledby="portfolio-callout-title">
				<div class="mx-auto grid max-w-6xl gap-8 px-5 py-[3.5rem] sm:px-8 sm:py-[4.65rem] md:grid-cols-[0.9fr_1.1fr] md:items-center md:gap-12">
						<div id="portfolio-highlight" class="relative aspect-[4/3] min-h-64 overflow-hidden rounded-[1.5rem] border border-[#e4ddd2] bg-[#e8eef0] shadow-xl max-[380px]:hidden md:aspect-auto md:h-[22rem]">
							<div class="flex h-full min-h-64 items-center justify-center p-8 text-center text-[#486174]">Carregando trabalhos personalizados...</div>
					</div>
					<div class="flex flex-col justify-center py-2 sm:py-8">
						<p class="text-sm font-bold uppercase tracking-[0.2em] text-[#c96f4a]">Inspire-se</p>
						<h2 id="portfolio-callout-title" class="brand-display mt-3 text-5xl font-bold leading-tight text-[#18324a] sm:text-6xl">Personalização que ganha forma</h2>
						<p class="mt-5 max-w-xl text-lg leading-8 text-[#486174]">Veja exemplos de peças personalizadas para empresas, eventos e momentos especiais.</p>
						<a href="/portfolio" class="mt-7 inline-flex min-h-12 w-fit items-center justify-center rounded-full bg-[#18324a] px-5 py-3 font-bold text-white hover:bg-[#274c69]">Conhecer o portfólio <span class="ml-2" aria-hidden="true">→</span></a>
					</div>
				</div>
			</section>

			<section id="catalogo" class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
				<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.2em] text-[#c96f4a]">Escolha com calma</p>
						<h2 id="catalog-title" class="brand-display mt-2 text-4xl font-bold text-[#18324a]">Catálogo de peças</h2>
					</div>
					<p id="product-total-label" class="hidden text-sm text-[#486174]"><span id="product-total-count">0</span> produto(s)</p>
				</div>
				<p class="mt-5 rounded-2xl border border-[#e8c9a5] bg-[#fff4e8] px-5 py-3 text-center text-sm text-[#7b4a2d]">
					<strong>Importante:</strong> o valor dos produtos não inclui o frete, e o prazo de entrega deve ser consultado.
				</p>

				{error ? (
					<div class="mt-8 rounded-3xl border border-red-200 bg-red-50 p-6 text-red-900" role="alert">
						<h3 class="font-semibold">Não foi possível carregar o catálogo.</h3>
						<p class="mt-2 text-sm">Tente novamente em alguns instantes ou fale conosco pelo WhatsApp.</p>
					</div>
				) : renderCatalog ? (
					<div class="mt-8 rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-8 text-center">
						<h3 class="text-lg font-semibold">Estamos preparando nosso catálogo</h3>
						<p class="mx-auto mt-2 max-w-xl text-slate-600">
							Enquanto isso, fale com nossa equipe para consultar produtos e condições especiais.
						</p>
						<a
							href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
								'Olá! Vim pelo site da Art Brasil e gostaria de conhecer os produtos.',
							)}`}
							class="mt-5 inline-flex rounded-full bg-[#c96f4a] px-5 py-3 font-bold text-white hover:bg-[#a95235]"
						>
							Pedir informações pelo WhatsApp
						</a>
					</div>
				) : (
					<>
						<div class="catalog-search mt-8">
							<label for="product-search" class="block text-sm font-bold text-[#18324a]">
								Encontre seu produto
							</label>
							<div class="relative mt-2">
								<span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-[#c96f4a]" aria-hidden="true">
									<svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2">
										<circle cx="11" cy="11" r="7"></circle>
										<path d="m20 20-4-4"></path>
									</svg>
								</span>
								<input
									id="product-search"
									type="search"
									class="w-full rounded-2xl border border-[#d8cfc2] bg-[#fffdf9] py-3.5 pl-12 pr-12 text-[#18324a] shadow-sm placeholder:text-[#7b8b95] focus:border-[#c96f4a] focus:outline-none focus:ring-2 focus:ring-[#c96f4a]/20"
									placeholder="Busque por nome, tag, capacidade ou código"
									autocomplete="off"
								/>
								<button
									id="clear-product-search"
									type="button"
									class="absolute right-4 top-1/2 hidden h-10 -translate-y-1/2 items-center rounded-lg px-2 text-sm font-bold text-[#486174] hover:bg-[#f1e8dc] hover:text-[#18324a]"
									aria-label="Limpar busca"
								>
									Limpar
								</button>
							</div>
							<p class="mt-2 text-xs text-[#486174]">Você pode digitar apenas parte do nome, como “300”, “can” ou “café”.</p>
						</div>

							{true && (
								<nav id="product-filters" class="mt-8 flex flex-wrap gap-2" aria-label="Filtrar produtos por categoria">
								<button
									type="button"
									class="filter-button is-active rounded-full border border-[#18324a] bg-[#18324a] px-4 py-3 text-sm font-bold text-white"
									data-filter="todos"
								>
									Todos
								</button>
								{tags.map((tag) => (
									<button
										type="button"
										class="filter-button rounded-full border border-[#c8d0d2] bg-[#fffdf9] px-4 py-3 text-sm font-bold text-[#486174] hover:border-[#18324a]"
										data-filter={tag}
									>
										{tag}
									</button>
								))}
							</nav>
						)}

						<p class="mt-4 text-sm text-slate-600" aria-live="polite">
							<span id="visible-product-count">{produtos.length}</span> produto(s) exibido(s)
						</p>

						<div id="catalog-loading" class="mt-8 rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-8 text-center" role="status" aria-live="polite">
							<span class="loading-spinner" aria-hidden="true"></span>
							<p class="mt-3 text-[#486174]">Carregando catálogo...</p>
						</div>
						<div id="catalog-load-error" class="mt-8 hidden rounded-3xl border border-red-200 bg-red-50 p-6 text-red-900" role="alert">
							<h3 class="font-semibold">Não foi possível carregar o catálogo.</h3>
							<p class="mt-2 text-sm">Tente novamente em alguns instantes ou fale conosco pelo WhatsApp.</p>
						</div>
						<div id="catalog-empty" class="mt-8 hidden rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-8 text-center">
							<h3 class="text-lg font-semibold">Estamos preparando nosso catálogo</h3>
							<p class="mx-auto mt-2 max-w-xl text-slate-600">Enquanto isso, fale com nossa equipe para consultar produtos e condições especiais.</p>
						</div>
						<div id="product-grid" class="mt-2 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
						{produtos.map((produto) => (
							<article
								class:list={[
									'product-card flex h-full flex-col overflow-hidden rounded-3xl border shadow-sm',
									{ 'is-featured': produto.destaque },
								]}
								data-tags={produto.tags.join('|')}
								data-search={`${produto.nome} ${produto.codigo} ${produto.tags.join(' ')} ${produto.fotos.join(' ')}`}
							>
								{produto.fotos.length > 0 ? (
									<div class="product-gallery" data-gallery data-image-loading>
										<div class="relative">
											<div class="gallery-loading" aria-hidden="true">
												<span class="loading-spinner"></span>
												<span>Carregando imagem...</span>
											</div>
											{produto.destaque && (
												<span class="featured-badge absolute left-4 top-4 z-10 rounded-full px-3 py-1.5 text-xs font-bold uppercase tracking-[0.12em]">
													Destaque
												</span>
											)}
											{Number(produto.preco_promocional ?? 0) > 0 && <span class="absolute right-4 top-4 z-10 rounded-full bg-[#a95235] px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.12em] text-white shadow-lg">Promoção</span>}
											{produto.fotos.map((foto, index) => (
												<img
													src={productImage(foto)}
													alt={`${produto.nome} - imagem ${index + 1} de ${produto.fotos.length}`}
													class:list={[
														'aspect-square w-full object-cover',
														{ hidden: index !== 0 },
													]}
													data-gallery-image
													data-image-index={index}
														loading="lazy"
														decoding="async"
												/>
											))}
											{produto.fotos.length > 1 && (
												<>
													<button
														type="button"
														class="gallery-control gallery-previous absolute left-3 top-1/2 -translate-y-1/2 rounded-full border-2 border-[#18324a] bg-[#fffdf9]/95 text-xl font-bold text-[#18324a] shadow-lg hover:bg-white"
														aria-label={`Ver imagem anterior de ${produto.nome}`}
													>
														<span class="flex h-full items-center justify-center text-4xl leading-none -translate-y-px" aria-hidden="true">‹</span>
													</button>
													<button
														type="button"
														class="gallery-control gallery-next absolute right-3 top-1/2 -translate-y-1/2 rounded-full border-2 border-[#18324a] bg-[#fffdf9]/95 text-xl font-bold text-[#18324a] shadow-lg hover:bg-white"
														aria-label={`Ver próxima imagem de ${produto.nome}`}
													>
														<span class="flex h-full items-center justify-center text-4xl leading-none -translate-y-px" aria-hidden="true">›</span>
													</button>
													<p
														class="gallery-counter absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-[#18324a]/85 px-3 py-1 text-xs font-bold text-white"
														aria-live="polite"
													>
														1 / {produto.fotos.length}
													</p>
												</>
											)}
										</div>
									</div>
								) : (
									<div class="relative flex aspect-square items-center justify-center bg-[#e8eef0] text-sm text-[#486174]">
										{produto.destaque && (
											<span class="featured-badge absolute left-4 top-4 rounded-full px-3 py-1.5 text-xs font-bold uppercase tracking-[0.12em]">
												Destaque
											</span>
										)}
											{Number(produto.preco_promocional ?? 0) > 0 && <span class="absolute right-4 top-4 z-10 rounded-full bg-[#a95235] px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.12em] text-white shadow-lg">Promoção</span>}
										Foto em breve
									</div>
								)}
								<div class="flex flex-1 flex-col p-5">
									<h3 class="flex min-h-14 items-center justify-center text-center text-lg font-bold text-[#18324a]">{produto.nome}</h3>
					<div class="mt-3 mb-3 flex h-14 items-end justify-end gap-2 text-right">
						{Number(produto.preco_promocional ?? 0) > 0 ? <div class="flex h-10 items-end justify-end"><div class="relative"><span class="absolute bottom-full right-0 whitespace-nowrap text-base font-normal text-[#486174] line-through">De: {formatPrice(produto.preco_peca_branca)}</span><p class="text-2xl font-bold leading-none text-[#c96f4a] sm:text-3xl"><span class="text-sm font-normal text-[#486174]">Por:</span> {formatPrice(promotionalPrice(produto))} <span class="text-sm font-normal text-[#486174]">por pç</span></p></div></div> : <p class="text-2xl font-bold leading-none text-[#c96f4a] sm:text-3xl">{formatPrice(produto.preco_peca_branca)} <span class="text-sm font-normal text-[#486174]">por pç</span></p>}
					</div>
								<div class="mt-auto grid gap-2">
									<a
										href={whatsappLink(produto)}
										class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#c96f4a] px-4 py-3 text-center font-bold text-white hover:bg-[#a95235]"
									>
										Pedir orçamento pelo WhatsApp
									</a>
									<button
										type="button"
										class="simulation-open-button inline-flex min-h-11 w-full items-center justify-center rounded-full border-2 border-[#18324a] px-4 py-2.5 text-center font-bold text-[#18324a] hover:bg-[#e8eef0]"
										data-product-name={produto.nome}
						data-product-price={promotionalPrice(produto)}
						data-product-base-price={produto.preco_peca_branca}
										data-product-minimum={produto.quantidade_minima}
										aria-haspopup="dialog"
									>
										Calcular personalização
									</button>
								</div>
								</div>
							</article>
						))}
					<div id="no-search-results" class="mt-8 hidden rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-8 text-center" role="status">
						<h3 class="text-lg font-semibold text-[#18324a]">Nenhum produto encontrado</h3>
						<p class="mt-2 text-sm text-[#486174]">Tente outro nome, capacidade, código ou tag.</p>
					</div>
					</>
				)}
			</section>
		</main>
		<div id="simulation-modal" class="simulation-modal hidden" role="dialog" aria-modal="true" aria-labelledby="simulation-title" data-whatsapp-number={whatsappNumber}>
			<div class="simulation-modal-backdrop" data-close-simulation></div>
			<section id="simulation-modal-card" class="simulation-modal-card rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-5 shadow-2xl sm:p-8" tabindex="-1">
				<div id="simulation-loading" class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center rounded-3xl bg-[#fffdf9]/90" role="status" aria-live="polite" hidden>
					<div class="flex items-center gap-3 rounded-2xl border border-[#e4ddd2] bg-white px-5 py-4 text-sm font-bold text-[#18324a] shadow-lg">
						<span class="loading-spinner" aria-hidden="true"></span>
						<span>Carregando preços de personalização...</span>
					</div>
				</div>
				<div class="flex items-start justify-between gap-4">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.16em] text-[#c96f4a]">Simulador de personalização</p>
						<h2 id="simulation-title" class="brand-display mt-2 text-3xl font-bold text-[#18324a]">Calcular personalização</h2>
						<p id="simulation-product" class="mt-2 text-base font-bold text-[#486174]"></p>
					</div>
					<button type="button" class="rounded-full p-2 text-2xl leading-none text-[#486174] hover:bg-[#f1e8dc] hover:text-[#18324a]" data-close-simulation aria-label="Fechar simulador">×</button>
				</div>

				<form id="simulation-form" class="mt-7 space-y-6">
					<div id="simulation-quantity-section">
						<div class="flex items-center justify-between gap-3">
							<label for="simulation-quantity" class="block text-base font-bold text-[#18324a]">Quantidade de peças</label>
							<output id="simulation-quantity-output" for="simulation-quantity" class="rounded-full bg-[#fff1e9] px-3 py-1.5 text-base font-bold text-[#a95235]">10 peças</output>
						</div>
						<div class="mt-4 flex items-center gap-3">
							<button id="simulation-quantity-decrease" type="button" class="simulation-quantity-button" aria-label="Diminuir quantidade">−</button>
						<input id="simulation-quantity" type="range" min="1" max="201" step="1" value="10" class="simulation-range w-full" aria-describedby="simulation-quantity-help" />
							<button id="simulation-quantity-increase" type="button" class="simulation-quantity-button" aria-label="Aumentar quantidade">+</button>
						</div>
						<div class="mt-1 flex justify-between text-sm font-bold text-[#486174]" aria-hidden="true">
							<span id="simulation-quantity-min-label">10</span>
							<span id="simulation-quantity-max-label">200+</span>
						</div>
						<p id="simulation-quantity-help" class="mt-2 text-sm text-[#486174]">Arraste ou use os botões para escolher de uma em uma peça.</p>
					</div>

					<div id="simulation-colors-section">
						<label for="simulation-colors" class="block text-base font-bold text-[#18324a]">Cores da personalização</label>
						<select id="simulation-colors" class="mt-2 w-full rounded-2xl border border-[#d8cfc2] bg-white px-4 py-3.5 text-[#18324a] focus:border-[#c96f4a] focus:outline-none focus:ring-2 focus:ring-[#c96f4a]/20">
							<option value="1">1 cor</option>
							<option value="7">Mais de 6 cores</option>
						</select>
					</div>

					<fieldset id="simulation-application-section">
						<legend class="block text-base font-bold text-[#18324a]">Tipo de aplicação</legend>
						<div class="mt-2 grid gap-3 sm:grid-cols-2">
							<label class="simulation-choice">
								<input type="radio" name="simulation-application" value="frente" checked />
								<span><strong>Frente</strong><small class="text-sm">Logotipo</small></span>
							</label>
							<label class="simulation-choice">
								<input type="radio" name="simulation-application" value="faixa" />
								<span><strong>Faixa</strong><small class="text-sm">Em volta da peça</small></span>
							</label>
						</div>
					</fieldset>

					<div id="simulation-info-section" class="space-y-2">
						<p class="rounded-2xl border border-[#e8c9a5] bg-[#fff4e8] px-4 py-3 text-base leading-6 text-[#7b4a2d]">
							<strong>Prazo de entrega:</strong> consulte a equipe antes de fechar o pedido.
						</p>
						<p class="rounded-2xl border border-[#c8d0d2] bg-[#e8eef0] px-4 py-3 text-base leading-6 text-[#486174]">
							Para uma estimativa mais precisa, faça um orçamento pelo WhatsApp. Os valores não incluem frete.
						</p>
						<p id="simulation-minimum-order" class="rounded-2xl border border-[#b8cbe0] bg-[#eef5fb] px-4 py-3 text-base font-bold leading-6 text-[#18324a]" role="status">
							Pedido mínimo: consulte a quantidade mínima deste produto.
						</p>
					</div>
					<div id="simulation-result" class="rounded-2xl border border-[#d99a70] bg-[#fff1e9] p-5" aria-live="polite">
						<p class="text-base font-bold uppercase tracking-[0.14em] text-[#a95235]">Estimativa da decoração</p>
