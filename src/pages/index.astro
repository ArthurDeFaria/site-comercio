		<script id="decoration-price-data" type="application/json" set:html={JSON.stringify({})}></script>
		<script>
			import { supabase as browserSupabase } from '../lib/supabase';
			type ProductRecord = {
				id: string;
				nome: string;
				codigo: string;
				preco_peca_branca: number | string;
				preco_promocional?: number | string | null;
				quantidade_minima: number;
				fotos: string[];
				tags: string[];
				destaque: boolean;
			};
			let buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
			let cards = document.querySelectorAll<HTMLElement>('.product-card');
			const productGrid = document.querySelector<HTMLElement>('#product-grid');
			const productFilters = document.querySelector<HTMLElement>('#product-filters');
			const catalogLoading = document.querySelector<HTMLElement>('#catalog-loading');
			const catalogLoadError = document.querySelector<HTMLElement>('#catalog-load-error');
			const catalogEmpty = document.querySelector<HTMLElement>('#catalog-empty');
			const productTotalLabel = document.querySelector<HTMLElement>('#product-total-label');
			const productTotalCount = document.querySelector<HTMLElement>('#product-total-count');
			const priceTableHead = document.querySelector<HTMLElement>('#price-table-head');
			const priceTableBody = document.querySelector<HTMLElement>('#price-table-body');
			const portfolioHighlight = document.querySelector<HTMLElement>('#portfolio-highlight');
			const count = document.querySelector<HTMLElement>('#visible-product-count');
			const searchInput = document.querySelector<HTMLInputElement>('#product-search');
			const clearSearch = document.querySelector<HTMLButtonElement>('#clear-product-search');
			const noSearchResults = document.querySelector<HTMLElement>('#no-search-results');
			const simulationModal = document.querySelector<HTMLElement>('#simulation-modal');
			const simulationLoading = document.querySelector<HTMLElement>('#simulation-loading');
			const simulationProduct = document.querySelector<HTMLElement>('#simulation-product');
			const simulationForm = document.querySelector<HTMLFormElement>('#simulation-form');
			const simulationQuantity = document.querySelector<HTMLInputElement>('#simulation-quantity');
			const simulationQuantityOutput = document.querySelector<HTMLOutputElement>('#simulation-quantity-output');
			const simulationQuantityDecrease = document.querySelector<HTMLButtonElement>('#simulation-quantity-decrease');
			const simulationQuantityIncrease = document.querySelector<HTMLButtonElement>('#simulation-quantity-increase');
			const simulationQuantityMaxLabel = document.querySelector<HTMLElement>('#simulation-quantity-max-label');
			const simulationQuantityMinLabel = document.querySelector<HTMLElement>('#simulation-quantity-min-label');
			const simulationColors = document.querySelector<HTMLSelectElement>('#simulation-colors');
			const simulationMinimumOrder = document.querySelector<HTMLElement>('#simulation-minimum-order');
			const simulationPieceCalculation = document.querySelector<HTMLElement>('#simulation-piece-calculation');
			const simulationSavings = document.querySelector<HTMLElement>('#simulation-savings');
			const simulationDecorationCalculation = document.querySelector<HTMLElement>('#simulation-decoration-calculation');
			const simulationTotalPrice = document.querySelector<HTMLElement>('#simulation-total-price');
			const simulationWhatsappQuote = document.querySelector<HTMLAnchorElement>('#simulation-whatsapp-quote');
			const priceTableModal = document.querySelector<HTMLElement>('#price-table-modal');
			const openPriceTable = document.querySelector<HTMLButtonElement>('#open-price-table');
			const simulationWhatsappNumber = simulationModal?.dataset.whatsappNumber ?? '';
			let lastSimulationTrigger: HTMLButtonElement | null = null;
			let selectedSimulationProduct = '';
			let selectedSimulationProductPrice = 0;
			let selectedSimulationProductBasePrice = 0;
			let selectedSimulationProductMinimum = 10;
			let selectedFilter = 'todos';
			let decorationPrices: Record<number, Record<number, number>> = {};
			const storageBaseUrl = `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/produtos/`;
			const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({
				'&': '&amp;',
				'<': '&lt;',
				'>': '&gt;',
				'"': '&quot;',
				"'": '&#039;',
			})[character] ?? character);
			const catalogImageUrl = (path: string) => path.startsWith('http') ? path : `${storageBaseUrl}${path.replace(/^\/+/, '')}`;
			const productPrice = (product: ProductRecord) => {
				const promotion = Number(product.preco_promocional ?? 0);
				return promotion > 0 ? promotion : Number(product.preco_peca_branca);
			};
			const productWhatsappUrl = (product: ProductRecord) => `https://wa.me/${simulationWhatsappNumber}?text=${encodeURIComponent(`Olá! Vim pelo site da Art Brasil e gostaria de orçar: ${product.nome}.`)}`;
			const renderProductCard = (product: ProductRecord) => {
				const photos = product.fotos ?? [];
				const productTags = product.tags ?? [];
				const promotion = Number(product.preco_promocional ?? 0);
				const images = photos.map((photo, index) => `<img src="${escapeHtml(catalogImageUrl(photo))}" alt="${escapeHtml(product.nome)} - imagem ${index + 1} de ${photos.length}" class="aspect-square w-full object-cover${index === 0 ? '' : ' hidden'}" data-gallery-image data-image-index="${index}" loading="lazy" decoding="async">`).join('');
				const gallery = photos.length > 0
					? `<div class="product-gallery" data-gallery data-image-loading><div class="relative"><div class="gallery-loading" aria-hidden="true"><span class="loading-spinner"></span><span>Carregando imagem...</span></div>${product.destaque ? '<span class="featured-badge absolute left-4 top-4 z-10 rounded-full px-3 py-1.5 text-xs font-bold uppercase tracking-[0.12em]">Destaque</span>' : ''}${promotion > 0 ? '<span class="absolute right-4 top-4 z-10 rounded-full bg-[#a95235] px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.12em] text-white shadow-lg">Promoção</span>' : ''}${images}${photos.length > 1 ? `<button type="button" class="gallery-control gallery-previous absolute left-3 top-1/2 -translate-y-1/2 rounded-full border-2 border-[#18324a] bg-[#fffdf9]/95 text-xl font-bold text-[#18324a] shadow-lg hover:bg-white" aria-label="Ver imagem anterior de ${escapeHtml(product.nome)}"><span class="flex h-full items-center justify-center text-4xl leading-none -translate-y-px" aria-hidden="true">‹</span></button><button type="button" class="gallery-control gallery-next absolute right-3 top-1/2 -translate-y-1/2 rounded-full border-2 border-[#18324a] bg-[#fffdf9]/95 text-xl font-bold text-[#18324a] shadow-lg hover:bg-white" aria-label="Ver próxima imagem de ${escapeHtml(product.nome)}"><span class="flex h-full items-center justify-center text-4xl leading-none -translate-y-px" aria-hidden="true">›</span></button><p class="gallery-counter absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-[#18324a]/85 px-3 py-1 text-xs font-bold text-white" aria-live="polite">1 / ${photos.length}</p>` : ''}</div></div>`
					: `<div class="relative flex aspect-square items-center justify-center bg-[#e8eef0] text-sm text-[#486174]">${product.destaque ? '<span class="featured-badge absolute left-4 top-4 rounded-full px-3 py-1.5 text-xs font-bold uppercase tracking-[0.12em]">Destaque</span>' : ''}${promotion > 0 ? '<span class="absolute right-4 top-4 z-10 rounded-full bg-[#a95235] px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.12em] text-white shadow-lg">Promoção</span>' : ''}Foto em breve</div>`;
				const price = productPrice(product);
				const priceHtml = promotion > 0
					? `<div class="flex h-10 items-end justify-end"><div class="relative"><span class="absolute bottom-full right-0 whitespace-nowrap text-base font-normal text-[#486174] line-through">De: ${formatSimulationPrice(Number(product.preco_peca_branca))}</span><p class="text-2xl font-bold leading-none text-[#c96f4a] sm:text-3xl"><span class="text-sm font-normal text-[#486174]">Por:</span> ${formatSimulationPrice(price)} <span class="text-sm font-normal text-[#486174]">por pç</span></p></div></div>`
					: `<p class="text-2xl font-bold leading-none text-[#c96f4a] sm:text-3xl">${formatSimulationPrice(price)} <span class="text-sm font-normal text-[#486174]">por pç</span></p>`;
				return `<article class="product-card flex h-full flex-col overflow-hidden rounded-3xl border shadow-sm${product.destaque ? ' is-featured' : ''}" data-tags="${escapeHtml(productTags.join('|'))}" data-search="${escapeHtml(`${product.nome} ${product.codigo} ${productTags.join(' ')} ${photos.join(' ')}`)}">${gallery}<div class="flex flex-1 flex-col p-5"><h3 class="flex min-h-14 items-center justify-center text-center text-lg font-bold text-[#18324a]">${escapeHtml(product.nome)}</h3><div class="mt-3 mb-3 flex h-14 items-end justify-end gap-2 text-right">${priceHtml}</div><div class="mt-auto grid gap-2"><a href="${escapeHtml(productWhatsappUrl(product))}" target="_blank" rel="noreferrer" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#c96f4a] px-4 py-3 text-center font-bold text-white hover:bg-[#a95235]">Pedir orçamento pelo WhatsApp</a><button type="button" class="simulation-open-button inline-flex min-h-11 w-full items-center justify-center rounded-full border-2 border-[#18324a] px-4 py-2.5 text-center font-bold text-[#18324a] hover:bg-[#e8eef0]" data-product-name="${escapeHtml(product.nome)}" data-product-price="${price}" data-product-base-price="${Number(product.preco_peca_branca)}" data-product-minimum="${Math.max(1, Number(product.quantidade_minima ?? 10))}" aria-haspopup="dialog">Calcular personalização</button></div></div></article>`;
			};
			const renderCatalogFilters = (products: ProductRecord[]) => {
				if (!productFilters) return;
				const catalogTags = [...new Set(products.flatMap((product) => product.tags ?? []))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
				productFilters.innerHTML = [`<button type="button" class="filter-button is-active rounded-full border border-[#18324a] bg-[#18324a] px-4 py-3 text-sm font-bold text-white" data-filter="todos">Todos</button>`, ...catalogTags.map((tag) => `<button type="button" class="filter-button rounded-full border border-[#c8d0d2] bg-[#fffdf9] px-4 py-3 text-sm font-bold text-[#486174] hover:border-[#18324a]" data-filter="${escapeHtml(tag)}">${escapeHtml(tag)}</button>`)].join('');
				selectedFilter = 'todos';
				bindFilterButtons();
			};
			const renderCatalog = (products: ProductRecord[]) => {
				if (!productGrid) return;
				productGrid.innerHTML = products.map(renderProductCard).join('');
				cards = productGrid.querySelectorAll<HTMLElement>('.product-card');
				renderCatalogFilters(products);
				bindGalleries();
				bindSimulationButtons();
				updateResults();
			};
			const loadCatalog = async () => {
				const { data, error: catalogError } = await browserSupabase.from('produtos').select('id, nome, codigo, preco_peca_branca, preco_promocional, quantidade_minima, fotos, tags, destaque').order('destaque', { ascending: false }).order('nome');
				if (catalogError) throw catalogError;
				const products = (data ?? []) as ProductRecord[];
				catalogLoading?.classList.add('hidden');
				catalogLoadError?.classList.add('hidden');
				catalogEmpty?.classList.toggle('hidden', products.length > 0);
				productTotalLabel?.classList.toggle('hidden', products.length === 0);
				if (productTotalCount) productTotalCount.textContent = String(products.length);
				if (products.length > 0) renderCatalog(products);
				else noSearchResults?.classList.add('hidden');
			};
			const renderPriceTable = (prices: Array<{ quantidade: number; cores: number; valor: number | string }>) => {
				if (!priceTableHead || !priceTableBody) return;
				const quantities = [...new Set(prices.map((price) => Number(price.quantidade)))].sort((a, b) => a - b);
				const colors = [...new Set(prices.map((price) => Number(price.cores)))].sort((a, b) => a - b);
				const priceMap = prices.reduce<Record<number, Record<number, number>>>((map, price) => {
					map[Number(price.quantidade)] ??= {};
					map[Number(price.quantidade)][Number(price.cores)] = Number(price.valor);
					return map;
				}, {});
				priceTableHead.innerHTML = `<tr><th class="px-3 py-3">Quantidade</th>${colors.map((color) => `<th class="px-3 py-3">${color} ${color === 1 ? 'cor' : 'cores'}</th>`).join('')}</tr>`;
				priceTableBody.innerHTML = quantities.map((quantity) => `<tr class="border-t border-[#e4ddd2] odd:bg-[#fff8f1]"><th class="px-3 py-2 font-bold text-[#18324a]">${quantity} peças</th>${colors.map((color) => `<td class="px-3 py-2">${priceMap[quantity]?.[color] !== undefined ? formatSimulationPrice(priceMap[quantity][color]) : '—'}</td>`).join('')}</tr>`).join('');
			};
			const loadPortfolioHighlight = async () => {
				const { data } = await browserSupabase.from('portfolio_projetos').select('titulo, descricao, imagem_path').eq('ativo', true).order('ordem', { ascending: true }).order('created_at', { ascending: false }).limit(1).maybeSingle();
				if (!data || !portfolioHighlight) return;
				const imageUrl = catalogImageUrl(data.imagem_path);
				portfolioHighlight.innerHTML = `<img src="${escapeHtml(imageUrl)}" alt="${escapeHtml(data.descricao ? `${data.titulo}: ${data.descricao}` : data.titulo)}" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async">`;
			};
			const refreshDecorationPrices = async () => {
				const { data } = await browserSupabase.from('precos_decoracao').select('quantidade, cores, valor').order('quantidade').order('cores');
				if (!data?.length) return;
				renderPriceTable(data);
				decorationPrices = data.reduce<Record<number, Record<number, number>>>((map, price) => {
					map[price.quantidade] ??= {};
					map[price.quantidade][price.cores] = Number(price.valor);
					return map;
				}, {});
				if (simulationColors) {
					const selectedColor = simulationColors.value;
					const colors = [...new Set(data.map((price) => Number(price.cores)))].sort((a, b) => a - b);
					simulationColors.innerHTML = `${colors.map((color) => `<option value="${color}">${color} ${color === 1 ? 'cor' : 'cores'}</option>`).join('')}<option value="${Math.max(7, ...colors, 6)}">Mais de ${Math.max(6, ...colors, 6)} cores</option>`;
					if (colors.includes(Number(selectedColor))) simulationColors.value = selectedColor;
				}
				if (simulationQuantity) {
					const maxQuantity = Math.max(...Object.keys(decorationPrices).map(Number), 200);
					simulationQuantity.max = String(maxQuantity + 1);
					if (simulationQuantityMaxLabel) simulationQuantityMaxLabel.textContent = `${maxQuantity}+`;
					if (Number(simulationQuantity.value) > maxQuantity + 1) simulationQuantity.value = String(maxQuantity + 1);
				}
				updateSimulation();
			};
			const formatSimulationPrice = (value: number) => value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
			const getQuantityBand = (quantity: number) => Object.keys(decorationPrices).map(Number).filter((band) => band <= quantity).pop() ?? null;
			const getApplicationMultiplier = () => document.querySelector<HTMLInputElement>('input[name="simulation-application"]:checked')?.value === 'faixa' ? 3 : 1;
			const updateSimulation = () => {
				const quantity = Number(simulationQuantity?.value ?? 10);
				const colors = Number(simulationColors?.value ?? 1);
				const band = getQuantityBand(quantity);
				if (!simulationPieceCalculation || !simulationDecorationCalculation || !simulationTotalPrice || !simulationWhatsappQuote) return;
				if (simulationMinimumOrder) simulationMinimumOrder.textContent = `Pedido mínimo: ${selectedSimulationProductMinimum} peças.`;
				if (simulationPieceCalculation) simulationPieceCalculation.textContent = `Peças: ${quantity} × ${formatSimulationPrice(selectedSimulationProductPrice)} = ${formatSimulationPrice(selectedSimulationProductPrice * quantity)}`;
				const savingsPerPiece = Math.max(0, selectedSimulationProductBasePrice - selectedSimulationProductPrice);
				if (simulationSavings) {
					simulationSavings.textContent = `Você economiza ${formatSimulationPrice(savingsPerPiece * quantity)} neste pedido.`;
					simulationSavings.classList.toggle('hidden', savingsPerPiece <= 0);
				}
				const maxQuantity = Math.max(...Object.keys(decorationPrices).map(Number), 0);
				if (!band || quantity > maxQuantity || decorationPrices[band]?.[colors] === undefined) {
					const specialReason = decorationPrices[band]?.[colors] === undefined ? `condição não cadastrada para ${colors} cores` : quantity > maxQuantity ? `mais de ${maxQuantity} peças` : `${quantity} peças`;
					if (simulationDecorationCalculation) simulationDecorationCalculation.textContent = `Personalização: condição especial para ${specialReason}.`;
					simulationTotalPrice.textContent = 'Total estimado: consulte a equipe (frete não incluso)';
					simulationWhatsappQuote.textContent = 'Cotar condição especial no WhatsApp';
					simulationWhatsappQuote.href = `https://wa.me/${simulationWhatsappNumber}?text=${encodeURIComponent(`Olá! Vim pelo site da Art Brasil e gostaria de cotar uma condição especial para ${selectedSimulationProduct}.\nQuantidade: ${quantity} peças.\nCores: ${colors > 6 ? 'mais de 6' : colors}.\nMotivo: ${specialReason}.`)}`;
					return;
				}
				const unitPrice = (decorationPrices[band]?.[colors] ?? 0) * getApplicationMultiplier();
				if (simulationDecorationCalculation) simulationDecorationCalculation.textContent = `Personalização: ${quantity} × ${formatSimulationPrice(unitPrice)} = ${formatSimulationPrice(unitPrice * quantity)}`;
				const subtotal = (selectedSimulationProductPrice + unitPrice) * quantity;
					simulationTotalPrice.textContent = `Total estimado: ${formatSimulationPrice(subtotal)} (frete não incluso)`;
				const application = document.querySelector<HTMLInputElement>('input[name="simulation-application"]:checked')?.value === 'faixa' ? 'Em volta da peça' : 'Logotipo';
				simulationWhatsappQuote.textContent = 'Enviar simulação pelo WhatsApp';
				simulationWhatsappQuote.href = `https://wa.me/${simulationWhatsappNumber}?text=${encodeURIComponent(`Olá! Vim pelo site da Art Brasil e gostaria de fazer um orçamento.\nProduto: ${selectedSimulationProduct}\nQuantidade: ${quantity} peças\nCores: ${colors}\nAplicação: ${application}\nValor da peça: ${formatSimulationPrice(selectedSimulationProductPrice)} por unidade\nDecoração: ${formatSimulationPrice(unitPrice)} por unidade\nTotal estimado: ${formatSimulationPrice(subtotal)} (frete não incluso).`)}`;
			};

			const updateQuantityOutput = () => {
				if (!simulationQuantityOutput || !simulationQuantity) return;
				const value = Number(simulationQuantity.value);
				const minimumQuantity = Number(simulationQuantity.min ?? selectedSimulationProductMinimum);
				const maxQuantity = Number(simulationQuantity?.max ?? 201) - 1;
				simulationQuantityOutput.textContent = value > maxQuantity ? `${maxQuantity}+ peças` : `${value} peças`;
				if (simulationQuantityDecrease) simulationQuantityDecrease.disabled = value <= minimumQuantity;
				if (simulationQuantityIncrease) simulationQuantityIncrease.disabled = value >= Number(simulationQuantity.max);
			};
			updateQuantityOutput();
			updateSimulation();
			refreshDecorationPrices();
			simulationQuantity?.addEventListener('input', updateQuantityOutput);
			simulationQuantity?.addEventListener('input', updateSimulation);
			simulationColors?.addEventListener('change', updateSimulation);
			document.querySelectorAll<HTMLInputElement>('input[name="simulation-application"]').forEach((input) => input.addEventListener('change', updateSimulation));
			simulationQuantityDecrease?.addEventListener('click', () => {
				if (!simulationQuantity) return;
				simulationQuantity.value = String(Math.max(Number(simulationQuantity.min), Number(simulationQuantity.value) - 1));
				updateQuantityOutput();
				updateSimulation();
			});
			simulationQuantityIncrease?.addEventListener('click', () => {
				if (!simulationQuantity) return;
				simulationQuantity.value = String(Math.min(Number(simulationQuantity.max), Number(simulationQuantity.value) + 1));
				updateQuantityOutput();
				updateSimulation();
			});

			const closeSimulation = () => {
				simulationModal?.classList.add('hidden');
				document.body.classList.remove('modal-is-open');
				lastSimulationTrigger?.focus();
				lastSimulationTrigger = null;
			};
			const closePriceTable = () => {
				priceTableModal?.classList.add('hidden');
				if (!simulationModal?.classList.contains('hidden')) openPriceTable?.focus();
			};
			openPriceTable?.addEventListener('click', async () => {
				await refreshDecorationPrices();
				priceTableModal?.classList.remove('hidden');
				priceTableModal?.querySelector<HTMLButtonElement>('button[data-close-price-table]')?.focus();
			});
			priceTableModal?.querySelectorAll<HTMLElement>('[data-close-price-table]').forEach((element) => element.addEventListener('click', closePriceTable));
			const bindSimulationButtons = () => {
				document.querySelectorAll<HTMLButtonElement>('.simulation-open-button').forEach((button) => {
					button.addEventListener('click', async () => {
					lastSimulationTrigger = button;
					simulationForm?.reset();
					selectedSimulationProduct = button.dataset.productName ?? '';
					selectedSimulationProductPrice = Number(button.dataset.productPrice ?? 0);
					selectedSimulationProductBasePrice = Number(button.dataset.productBasePrice ?? button.dataset.productPrice ?? 0);
					selectedSimulationProductMinimum = Math.max(1, Number(button.dataset.productMinimum ?? 10));
					if (simulationQuantity) simulationQuantity.min = String(selectedSimulationProductMinimum);
					if (simulationQuantityMinLabel) simulationQuantityMinLabel.textContent = String(selectedSimulationProductMinimum);
					if (simulationProduct) simulationProduct.textContent = `Produto: ${selectedSimulationProduct}`;
					simulationModal?.classList.remove('hidden');
					document.body.classList.add('modal-is-open');
					if (simulationForm) simulationForm.inert = true;
					if (simulationLoading) simulationLoading.hidden = false;
					simulationModal?.querySelector<HTMLButtonElement>('button[data-close-simulation]')?.focus();
					try {
						await refreshDecorationPrices();
					} finally {
						if (simulationLoading) simulationLoading.hidden = true;
						if (simulationForm) simulationForm.inert = false;
					}
					if (simulationQuantity && Number(simulationQuantity.max) <= selectedSimulationProductMinimum) {
						simulationQuantity.max = String(selectedSimulationProductMinimum + 1);
						if (simulationQuantityMaxLabel) simulationQuantityMaxLabel.textContent = `${selectedSimulationProductMinimum}+`;
					}
					if (simulationQuantity) simulationQuantity.value = String(Math.max(Number(simulationQuantity.min), Math.min(Number(simulationQuantity.max), selectedSimulationProductMinimum)));
					updateQuantityOutput();
					updateSimulation();
					window.setTimeout(() => simulationForm?.querySelector<HTMLElement>('select')?.focus(), 0);
				});
				});
			};
			simulationModal?.querySelectorAll<HTMLElement>('[data-close-simulation]').forEach((element) => element.addEventListener('click', closeSimulation));
			document.addEventListener('keydown', (event) => {
				const activeModal = !priceTableModal?.classList.contains('hidden')
					? priceTableModal
					: !simulationModal?.classList.contains('hidden')
						? simulationModal
						: null;
				if (!activeModal) return;

				if (event.key === 'Escape') {
					if (activeModal === priceTableModal) closePriceTable();
					else closeSimulation();
					return;
				}

				if (event.key === 'Tab') {
					const focusable = Array.from(activeModal.querySelectorAll<HTMLElement>(
						'a[href], button:not(:disabled), input:not(:disabled):not([type="hidden"]), select:not(:disabled), textarea:not(:disabled), [tabindex]:not([tabindex="-1"])',
					)).filter((element) => !element.closest('[inert]') && element.getClientRects().length > 0);
					if (focusable.length === 0) {
						event.preventDefault();
						activeModal.querySelector<HTMLElement>('.simulation-modal-card')?.focus();
						return;
					}
					const first = focusable[0];
					const last = focusable[focusable.length - 1];
					if (event.shiftKey && (document.activeElement === first || !activeModal.contains(document.activeElement))) {
						event.preventDefault();
						last.focus();
					} else if (!event.shiftKey && (document.activeElement === last || !activeModal.contains(document.activeElement))) {
						event.preventDefault();
						first.focus();
					}
				}
			});
			simulationForm?.addEventListener('submit', (event) => event.preventDefault());

			const normalizeText = (value: string) =>
				value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('pt-BR');

			const updateResults = () => {
				const searchTerms = normalizeText(searchInput?.value.trim() ?? '').split(/\s+/).filter(Boolean);
				let visibleCards = 0;

				cards.forEach((card) => {
					const productTags = (card.dataset.tags ?? '').split('|').map(normalizeText);
					const searchableText = normalizeText(card.dataset.search ?? '');
					const matchesFilter = selectedFilter === 'todos' || productTags.includes(normalizeText(selectedFilter));
					const matchesSearch = searchTerms.every((term) => searchableText.includes(term));
					const isVisible = matchesFilter && matchesSearch;
					card.hidden = !isVisible;
					if (isVisible) visibleCards += 1;
				});

				if (count) count.textContent = String(visibleCards);
				noSearchResults?.classList.toggle('hidden', visibleCards > 0);
				clearSearch?.classList.toggle('hidden', !searchInput?.value);
				clearSearch?.classList.toggle('inline-flex', Boolean(searchInput?.value));
			};

			const bindGalleries = () => {
				document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
				const images = Array.from(gallery.querySelectorAll<HTMLImageElement>('[data-gallery-image]'));
				const previous = gallery.querySelector<HTMLButtonElement>('.gallery-previous');
				const next = gallery.querySelector<HTMLButtonElement>('.gallery-next');
				const counter = gallery.querySelector<HTMLElement>('.gallery-counter');
				let currentIndex = 0;

				const showImage = (index: number) => {
					currentIndex = (index + images.length) % images.length;
					images.forEach((image, imageIndex) => {
						image.classList.toggle('hidden', imageIndex !== currentIndex);
					});
					if (counter) counter.textContent = `${currentIndex + 1} / ${images.length}`;
				};

				previous?.addEventListener('click', () => showImage(currentIndex - 1));
				next?.addEventListener('click', () => showImage(currentIndex + 1));
				images.forEach((image) => {
					image.addEventListener('load', () => gallery.removeAttribute('data-image-loading'), { once: true });
					image.addEventListener('error', () => gallery.setAttribute('data-image-error', ''), { once: true });
					if (image.complete) {
						if (image.naturalWidth > 0) gallery.removeAttribute('data-image-loading');
						else gallery.setAttribute('data-image-error', '');
					}
				});

				});
			};

			const bindFilterButtons = () => {
				buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
				buttons.forEach((button) => {
				button.addEventListener('click', () => {
					selectedFilter = button.dataset.filter ?? 'todos';

					buttons.forEach((currentButton) => {
						const isSelected = currentButton === button;
						currentButton.classList.toggle('is-active', isSelected);
						currentButton.classList.toggle('text-white', isSelected);
						currentButton.classList.toggle('border-[#c8d0d2]', !isSelected);
						currentButton.classList.toggle('bg-[#fffdf9]', !isSelected);
						currentButton.classList.toggle('text-[#486174]', !isSelected);
					});

					updateResults();
				});
				});
			};

			searchInput?.addEventListener('input', updateResults);
			clearSearch?.addEventListener('click', () => {
				if (searchInput) {
					searchInput.value = '';
					searchInput.focus();
				}
				updateResults();
			});
			loadCatalog().catch(() => {
				catalogLoading?.classList.add('hidden');
				catalogLoadError?.classList.remove('hidden');
			});
			loadPortfolioHighlight().catch(() => undefined);
		</script>
	</body>
</html>
