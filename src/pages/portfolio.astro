---
import '../styles/global.css';
import { supabase } from '../lib/supabase';

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://artbrasilpresentes.com.br');
const { data: projetosData } = await supabase
	.from('portfolio_projetos')
	.select('id, titulo, descricao, imagem_path')
	.order('ordem', { ascending: true })
	.order('created_at', { ascending: false });
const storageUrl = `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/produtos/`;
const projetos = (projetosData ?? []).map((projeto) => ({
	...projeto,
	src: projeto.imagem_path.startsWith('http') ? projeto.imagem_path : `${storageUrl}${projeto.imagem_path}`,
}));
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" type="image/jpeg" href="/favicon.jpg?v=2" />
		<meta name="viewport" content="width=device-width" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href="/sitemap.xml" />
		<meta name="description" content="Veja projetos de porcelanas personalizadas para empresas, eventos, casamentos e restaurantes da Art Brasil Presentes, em Pedreira (SP)." />
		<title>Portfólio de porcelanas personalizadas | Art Brasil Presentes</title>
	</head>
	<body id="topo">
		<header class="border-b border-[#e4ddd2] bg-[#fffdf9]">
			<div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-3 py-4 sm:gap-4 sm:px-8 sm:py-5">
				<a href="/" class="brand-display shrink-0 whitespace-nowrap text-xl font-bold text-[#18324a] min-[380px]:text-2xl sm:text-3xl">Art Brasil <span class="font-normal italic text-[#c96f4a]">Presentes</span></a>
				<a href="/" class="inline-flex min-h-11 min-w-24 shrink-0 items-center justify-center whitespace-nowrap rounded-full border-2 border-[#18324a] px-3 py-2 text-sm font-bold text-[#18324a] hover:bg-[#e8eef0] sm:px-4"><span class="sm:hidden">Catálogo</span><span class="hidden sm:inline">Voltar ao catálogo</span></a>
			</div>
		</header>

		<main>
			<section class="hero-wash border-b border-[#e4ddd2]">
				<div class="mx-auto grid min-w-0 max-w-6xl gap-10 px-5 py-14 sm:grid-cols-[0.9fr_1.1fr] sm:px-8 sm:py-20 sm:items-center">
					<div class="mx-auto w-full max-w-full min-w-0 overflow-hidden rounded-[2rem] border border-[#d8cfc2] bg-[#e8eef0] shadow-sm max-[380px]:hidden">
						{projetos[0] ? <img src={projetos[0].src} alt={projetos[0].descricao ? `${projetos[0].titulo}: ${projetos[0].descricao}` : projetos[0].titulo} class="aspect-[4/5] w-full object-cover" loading="eager" fetchpriority="high" decoding="async" /> : <div class="flex aspect-[4/5] items-center justify-center p-8 text-center text-[#486174]">Adicione um trabalho no painel para destacar uma imagem aqui.</div>}
					</div>
					<div class="min-w-0">
						<p class="text-sm font-bold uppercase tracking-[0.2em] text-[#c96f4a]">Trabalhos realizados</p>
						<h1 class="brand-display mt-5 w-full max-w-full break-words text-2xl font-bold leading-[0.92] text-[#18324a] [overflow-wrap:anywhere] sm:text-7xl lg:text-8xl">Portfólio de porcelanas <span class="italic text-[#c96f4a]">personalizadas.</span></h1>
						<p class="mt-7 max-w-md border-l-2 border-[#c96f4a] pl-5 text-base leading-7 text-[#486174] sm:pl-7">Projetos para empresas, eventos, casamentos e restaurantes. Cada porcelana personalizada leva a identidade de cada cliente aos detalhes.</p>
					</div>
				</div>
			</section>

			<section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16" aria-labelledby="portfolio-gallery-title">
				<div class="flex flex-col gap-3 border-b border-[#d8cfc2] pb-6 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.2em] text-[#c96f4a]">Galeria</p>
						<h2 id="portfolio-gallery-title" class="brand-display mt-2 text-4xl font-bold text-[#18324a]">Ideias para o seu projeto</h2>
					</div>
					<p class="max-w-md text-sm leading-6 text-[#486174]">Cada peça pode receber nomes, logotipos, frases e elementos da identidade visual do seu projeto.</p>
				</div>
				{projetos.length > 1 ? <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-12">
					{projetos.slice(1).map((projeto, index) => (
						<figure class:list={['group overflow-hidden rounded-[1.75rem] border border-[#e4ddd2] bg-[#fffdf9] shadow-sm', index === 0 ? 'lg:col-span-7 lg:row-span-2' : index === 1 || index === 2 ? 'lg:col-span-5' : 'lg:col-span-4']}>
							<div class:list={['relative overflow-hidden bg-[#e8eef0]', index === 0 ? 'aspect-[4/5] lg:h-full' : 'aspect-[4/3]']}>
								<img src={projeto.src} alt={projeto.descricao ? `${projeto.titulo}: ${projeto.descricao}` : projeto.titulo} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
								<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#18324a]/85 to-transparent p-5 pt-12 text-white"><h3 class="text-xl font-bold">{projeto.titulo}</h3>{projeto.descricao && <p class="mt-1 text-sm leading-6 text-[#e8eef0]">{projeto.descricao}</p>}</div>
							</div>
						</figure>
					))}
				</div> : <p class="mt-8 rounded-3xl border border-[#e4ddd2] bg-[#fffdf9] p-8 text-center text-[#486174]">Estamos preparando nossa galeria de trabalhos.</p>}
				<div class="mt-12 rounded-3xl border border-[#d99a70] bg-[#fff1e9] p-7 text-center sm:p-10">
					<h2 class="brand-display text-3xl font-bold text-[#18324a]">Gostou de alguma ideia?</h2>
					<p class="mx-auto mt-3 max-w-xl leading-7 text-[#486174]">Fale com a equipe e conte o que você gostaria de personalizar.</p>
					<a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Olá! Vim pelo portfólio da Art Brasil e gostaria de conversar sobre uma personalização.')}`} target="_blank" rel="noreferrer" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-[#c96f4a] px-6 py-3 font-bold text-white hover:bg-[#a95235]">Pedir orçamento pelo WhatsApp</a>
					<div><a href="/#catalogo" class="mt-3 inline-flex min-h-12 items-center justify-center rounded-full border-2 border-[#18324a] px-6 py-3 font-bold text-[#18324a] hover:bg-[#e8eef0]">Voltar ao catálogo</a></div>
				</div>
			</section>
		</main>

		<footer class="border-t border-[#d8cfc2] bg-[#18324a] text-[#fffdf9]">
			<div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 sm:px-8 lg:grid-cols-[1.4fr_1fr]">
				<div>
					<p class="brand-display text-2xl font-bold">Art Brasil <span class="font-normal italic text-[#e9a078]">Presentes</span></p>
					<p class="mt-4 max-w-md leading-7 text-[#dce8e8]">Porcelanas personalizadas para brindes, eventos e estabelecimentos, com atendimento personalizado.</p>
				</div>
				<div>
					<h2 class="text-sm font-bold uppercase tracking-[0.16em] text-[#e9a078]">Canais oficiais</h2>
					<ul class="mt-4 space-y-3">
						<li><a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noreferrer" class="underline-offset-4 hover:text-[#e9a078] hover:underline">WhatsApp: (19) 99140-7919</a></li>
						<li>
							<a href="https://www.instagram.com/artbrasilpresentes/" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 underline-offset-4 hover:text-[#e9a078] hover:underline" aria-label="Instagram da Art Brasil Presentes">
								<svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-2" aria-hidden="true">
									<rect x="3" y="3" width="18" height="18" rx="5"></rect>
									<circle cx="12" cy="12" r="4"></circle>
									<circle cx="17.5" cy="6.5" r="1" class="fill-current stroke-0"></circle>
								</svg>
								Instagram: @artbrasilpresentes
							</a>
						</li>
						<li><a href="/informacoes" class="underline-offset-4 hover:text-[#e9a078] hover:underline">Termos e condições</a></li>
					</ul>
				</div>
			</div>
			<div class="border-t border-[#486174] px-5 py-5 text-center text-sm text-[#dce8e8] sm:px-8">
				<p>© 2026 ArtBrasil Presentes · CNPJ: 58.151.605/0001-63 · Pedreira - SP</p>
			</div>
		</footer>
	</body>
</html>
