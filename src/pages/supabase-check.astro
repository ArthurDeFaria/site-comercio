---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
			<link rel="icon" type="image/png" href="/logo.png?v=4" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Verificação do Supabase</title>
	</head>
	<body>
		<main>
			<h1>Verificação do Supabase</h1>
			<p><strong>Status:</strong> <span id="status">Verificando...</span></p>
			<ul>
				<li>Produtos: <span id="products">Verificando...</span></li>
				<li>Preços de decoração: <span id="prices">Verificando...</span></li>
			</ul>
			<section id="errors" aria-labelledby="errors-title" hidden>
				<h2 id="errors-title">Erros</h2>
				<ul id="error-list"></ul>
			</section>
		</main>
		<script>
			import { supabase } from '../lib/supabase';
			const status = document.querySelector<HTMLElement>('#status');
			const products = document.querySelector<HTMLElement>('#products');
			const prices = document.querySelector<HTMLElement>('#prices');
			const errors = document.querySelector<HTMLElement>('#errors');
			const errorList = document.querySelector<HTMLElement>('#error-list');
			const check = async () => {
				const [{ data: productData, error: productError }, { data: priceData, error: priceError }] = await Promise.all([
					supabase.from('produtos').select('id').limit(1),
					supabase.from('precos_decoracao').select('quantidade').limit(1),
				]);
				const queryErrors = [productError, priceError].filter(Boolean);
				if (status) status.textContent = queryErrors.length ? 'Falha nas consultas.' : 'Conexão e consultas realizadas com sucesso.';
				if (products) products.textContent = productError ? 'erro' : `${productData?.length ?? 0} registro(s) na amostra`;
				if (prices) prices.textContent = priceError ? 'erro' : `${priceData?.length ?? 0} registro(s) na amostra`;
				if (queryErrors.length && errors && errorList) {
					errors.hidden = false;
					errorList.innerHTML = queryErrors.map((error) => `<li>${error?.message ?? 'Erro desconhecido'}</li>`).join('');
				}
			};
			check();
		</script>
	</body>
</html>
